#!/usr/bin/env bash
# dgclaw de mentira para o teste do reset: registra a chamada e, ao iniciar, faz o papel do runner
# (grava um runner-state.json novo) e do agente (que pode escrever memoria logo na partida).
echo "dgclaw $*" >> "${STUB_LOG:?}"
if [ "${1:-}" = agente ] && [ "${2:-}" = parar ] && [ -n "${STUB_FALHA_PARAR:-}" ]; then echo "podman: container nao existe" >&2; exit 1; fi
if [ "${1:-}" = agente ] && [ "${2:-}" = iniciar ]; then
    mkdir -p "${STUB_CASA:?}/.plataforma"
    printf '{"sessionId":"%s"}\n' "${STUB_SESSAO_NOVA:-sessao-nova}" > "$STUB_CASA/.plataforma/runner-state.json"
    if [ -n "${STUB_ESCREVE_ROLLOUT:-}" ]; then mkdir -p "$STUB_CASA/.plataforma/codex-api/x/sessions/2026/11"; echo velha > "$STUB_CASA/.plataforma/codex-api/x/sessions/2026/11/rollout-9.jsonl"; fi
    if [ -n "${STUB_ESCREVE_MEMORIA:-}" ]; then mkdir -p "$STUB_CASA/memory"; echo velha > "$STUB_CASA/memory/2026-11-09.md"; fi
fi
exit 0
