#!/usr/bin/env bash
# podman de mentira do smoke-entrega: o estado vem de arquivos em $STUB_ESTADO (ausente = valor padrao).
# O smoke nao pode chamar "podman exec": se chamar, a linha fica no log e o teste falha.
est="${STUB_ESTADO:?}"
echo "podman $*" >>"${STUB_LOG:?}"
val() { if [ -f "$est/$1" ]; then cat "$est/$1"; else printf '%s' "$2"; fi; }
[ -f "$est/podman-mudo" ] && exit 125
case "${1:-}" in
    container)
        [ "${2:-}" = exists ] && exit "$(val existe 0)" ;;
    inspect)
        case "$*" in
            *State.Running*) val rodando true; echo ;;
            *HostConfig.Memory*) val memoria 4294967296; echo ;;
        esac
        exit 0 ;;
esac
exit 0
