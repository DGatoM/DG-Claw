#!/usr/bin/env bash
# podman de mentira do smoke-entrega: o estado vem de arquivos em $STUB_ESTADO (ausente = valor padrao).
est="${STUB_ESTADO:?}"
val() { if [ -f "$est/$1" ]; then cat "$est/$1"; else printf '%s' "$2"; fi; }
case "${1:-}" in
    inspect)
        fmt="$*"
        case "$fmt" in
            *State.Status*) val estado running; echo ;;
            *CgroupPath*) val cgpath /machine.slice/libpod-abc.scope; echo ;;
            *PidsLimit*) val pids-limit 4096; echo ;;
        esac
        exit 0 ;;
    exec)
        shift
        echo "podman exec $*" >>"${STUB_LOG:?}"
        if [ "${1:-}" = --user ] || [ "${1:-}" = -u ]; then shift 2; fi
        shift # o nome do container
        args="$*"
        case "$args" in
            "systemctl show -p "*) [ -f "$est/systemctl-erro" ] && exit 3 ;;&
            "systemctl show -p TasksMax --value dgclaw-runner") [ -f "$est/tasks-quebras" ] && { printf 2400; head -c 4100 /dev/zero | tr '\0' '\n'; exit 0; }
                                                                [ -f "$est/tasks-nul" ] && { printf '2400\0\n'; exit 0; }
                                                                [ -f "$est/tasks-duas-linhas" ] && { printf '2400\n2400\n'; exit 0; }
                                                                [ -f "$est/tasks-lixo" ] && { echo "texto livre do container"; exit 0; }
                                                                val tasksmax 2400; echo ;;
            "systemctl show -p OOMPolicy --value dgclaw-runner") val oompolicy continue; echo ;;
            "systemctl show -p NRestarts --value dgclaw-runner") val nrestarts 0; echo ;;
            journalctl*) [ -f "$est/journal-erro" ] && exit 1
                         case "$args" in *short-unix*)
                             [ -f "$est/runner-vazio" ] && exit 0
                             echo "$(( $(date +%s) - $(cat "$est/runner-dias" 2>/dev/null || echo 9) * 86400 - 60 )).000000 runner: inicio"; exit 0 ;;
                         esac
                         [ -f "$est/journal-oom-grande" ] && { echo "kernel: Out of memory: Killed process 4242 (chrome)"; head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
                         [ -f "$est/journal-grande" ] && { head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
                         [ -f "$est/oom-journal" ] && echo "kernel: Out of memory: Killed process 4242 (chrome)"; exit 0 ;;
            "sh -c command -v ffmpeg") [ -f "$est/ffmpeg-erro" ] && exit 125; [ -f "$est/sem-ffmpeg-container" ] && exit 1; echo /usr/bin/ffmpeg ;;
            "sh -c command -v yt-dlp") [ -f "$est/yt-grande" ] && { head -c 6000 /dev/zero | tr '\0' 'a'; exit 0; }
                                       val yt-path /usr/local/bin/yt-dlp; echo ;;
            "sh -c command -v google-chrome-stable") echo /usr/bin/google-chrome-stable ;;
            "grep -qE "*/etc/yt-dlp.conf) [ -f "$est/yt-conf-erro" ] && exit 2; [ -f "$est/sem-yt-conf" ] && exit 1; exit 0 ;;
            "test -d /home/agente/.tela-chrome") [ -f "$est/sem-perfil-tela" ] && exit 1; exit 0 ;;
            "mktemp -d /tmp/smoke-entrega.XXXXXX") [ -f "$est/mktemp-erro" ] && exit 1
                                                   [ -f "$est/mktemp-barra" ] && { echo /tmp/smoke-entrega.ab/c12; exit 0; }
                                                   [ -f "$est/mktemp-casa" ] && { echo /home/agente/dados; exit 0; }
                                                   echo /tmp/smoke-entrega.abc123 ;;
            "rm -rf -- /tmp/smoke-entrega.abc123") exit 0 ;;
            google-chrome-stable*) exit 0 ;;
        esac
        exit 0 ;;
esac
exit 0
