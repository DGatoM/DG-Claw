#!/usr/bin/env bash
# podman de mentira do smoke-entrega: o estado vem de arquivos em $STUB_ESTADO (ausente = valor padrao).
est="${STUB_ESTADO:?}"
val() { if [ -f "$est/$1" ]; then cat "$est/$1"; else printf '%s' "$2"; fi; }
case "${1:-}" in
    inspect)
        fmt="$*"
        case "$fmt" in
            *State.Status*) val estado running; echo ;;
            *PidsLimit*) echo "$(val pids-limit 4096) $(val mem 4294967296) $(val nano 0)" ;;
        esac
        exit 0 ;;
    exec)
        shift
        [ "${1:-}" = -u ] && shift 2
        shift # o nome do container
        args="$*"
        case "$args" in
            "cat /sys/fs/cgroup/pids.max") val pids-max max; echo ;;
            "systemctl show -p TasksMax --value dgclaw-runner") val tasksmax 2400; echo ;;
            "systemctl show -p OOMPolicy --value dgclaw-runner") val oompolicy continue; echo ;;
            "systemctl show -p NRestarts --value dgclaw-runner") val nrestarts 0; echo ;;
            "systemctl restart dgclaw-runner") [ -f "$est/restart-falha" ] && exit 1; exit 0 ;;
            journalctl*) [ -f "$est/oom-journal" ] && echo "kernel: Out of memory: Killed process 4242 (chrome)"; exit 0 ;;
            "pgrep -c chrome") val chrome-n 1; echo ;;
            pgrep\ -f*) [ -f "$est/sem-sessao" ] && exit 1; exit 0 ;;
            "sh -c command -v ffmpeg") [ -f "$est/sem-ffmpeg-container" ] && exit 1; echo /usr/bin/ffmpeg ;;
            "sh -c command -v yt-dlp") val yt-path /usr/local/bin/yt-dlp; echo ;;
            "sh -c command -v google-chrome-stable") echo /usr/bin/google-chrome-stable ;;
            grep\ *yt-dlp/config) [ -f "$est/sem-yt-config" ] && exit 1; exit 0 ;;
            yt-dlp*) if [ -f "$est/yt-falha" ]; then echo "ERROR: Sign in to confirm you are not a bot" >&2; exit 1; fi
                     : >"$est/video-baixado"; exit 0 ;;
            "sh -c ls /tmp/smoke-entrega-yt.* >/dev/null 2>&1") [ -f "$est/video-baixado" ]; exit $? ;;
            "sh -c rm -f /tmp/smoke-entrega-yt.*") rm -f "$est/video-baixado"; exit 0 ;;
            google-chrome-stable*)
                if [ -f "$est/chrome-sobra" ]; then echo $(( $(val chrome-n 1) + 2 )) >"$est/chrome-n"; fi
                exit 0 ;;
        esac
        exit 0 ;;
esac
exit 0
