#!/usr/bin/env bash
# journalctl de mentira (kernel do servidor; o smoke sempre pede -o short-unix). Primeira linha: a entrada mais
# antiga que o journal guarda (kernel-dias = quantos dias atras, padrao 9; kernel-horas, se existir, vale no lugar).
# Marcas em $STUB_ESTADO: kernel-vazio (sem entradas), oom-host (uma linha de OOM), journal-host-erro (sai com 1 sem
# saida), kernel-saida-erro (imprime a primeira linha e sai com 1), journal-grande (mais de 1 MiB sem OOM) e
# journal-oom-grande (um OOM e depois mais de 1 MiB).
est="${STUB_ESTADO:?}"
echo "journalctl $*" >>"${STUB_LOG:?}"
[ -f "$est/journal-host-erro" ] && exit 1
agora="$(date +%s)"
[ -f "$est/kernel-vazio" ] && exit 0
if [ -f "$est/kernel-horas" ]; then seg=$(( $(cat "$est/kernel-horas") * 3600 ))
else seg=$(( $(cat "$est/kernel-dias" 2>/dev/null || echo 9) * 86400 )); fi
echo "$(( agora - seg - 60 )).000000 host kernel: boot"
[ -f "$est/kernel-saida-erro" ] && exit 1
[ -f "$est/oom-host" ] && echo "$(( agora - 60 )).000000 host kernel: Out of memory: Killed process 77 (node)"
[ -f "$est/journal-oom-grande" ] && { echo "$(( agora - 60 )).000000 host kernel: Out of memory: Killed process 4242 (chrome)"; head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
[ -f "$est/journal-grande" ] && { head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
exit 0
