#!/usr/bin/env bash
# journalctl de mentira (kernel do servidor). Sem -o: so imprime algo se o teste marcar oom-host.
# Com -o short-unix: a entrada mais antiga que o journal guarda (kernel-dias = quantos dias atras; padrao 9;
# kernel-horas, se existir, vale no lugar e diz quantas horas atras).
est="${STUB_ESTADO:?}"
echo "journalctl $*" >>"${STUB_LOG:?}"
[ -f "$est/journal-host-erro" ] && exit 1
case "$*" in
    *short-unix*)
        [ -f "$est/kernel-vazio" ] && exit 0
        if [ -f "$est/kernel-horas" ]; then seg=$(( $(cat "$est/kernel-horas") * 3600 ))
        else seg=$(( $(cat "$est/kernel-dias" 2>/dev/null || echo 9) * 86400 )); fi
        echo "$(( $(date +%s) - seg - 60 )).000000 host kernel: boot" ;;
    *) [ -f "$est/oom-host" ] && echo "kernel: Out of memory: Killed process 77 (node)" ;;
esac
exit 0
