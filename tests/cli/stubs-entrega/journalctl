#!/usr/bin/env bash
# journalctl de mentira (kernel do servidor; o smoke sempre pede -o short-unix). Cada marca em $STUB_ESTADO define
# entradas com timestamps; o stub filtra por --since "@N" e --until "@N", entende -r (mais recente primeiro) e -n N,
# e nunca fabrica entrada no instante do --since. A entrada de boot e a mais antiga que o journal guarda
# (kernel-dias = quantos dias atras, padrao 9; kernel-horas, se existir, vale no lugar, os dois com 60 s de folga
# para o relogio nao virar a contagem; kernel-seg = exatamente esses segundos atras, no lugar dos dois). Marcas: kernel-vazio (sem entradas), oom-host (uma linha de OOM 60 s
# atras), oom-seg (uma linha de OOM esses segundos atras), kernel-extra (uma entrada comum para cada numero de
# segundos atras que o arquivo traz, um por linha), kernel-msg (uma linha para cada mensagem do arquivo, 120 s atras),
# hostname-oom (o hostname das linhas e "oom-kill-test", sem OOM na mensagem), journal-host-erro (sai com 1 sem saida),
# kernel-saida-erro (imprime a primeira linha e sai com 1), kernel-oom-erro (imprime a linha de boot e uma de OOM e sai
# com 1), journal-grande (mais de 1 MiB sem OOM) e journal-oom-grande (um OOM e depois mais de 1 MiB). As quatro
# ultimas so valem na consulta sem --until (a contagem de OOM).
est="${STUB_ESTADO:?}"
echo "journalctl $*" >>"${STUB_LOG:?}"
[ -f "$est/journal-host-erro" ] && exit 1
agora="$(date +%s)"
since=0; until_=$((agora + 86400)); rev=0; limite=0; tem_until=0
while [ $# -gt 0 ]; do
    case "$1" in
        --since|--until)
            case "${2:-}" in @[0-9]*) ;; *) echo "journalctl de mentira: $1 inesperado: ${2:-}" >&2; exit 2 ;; esac
            if [ "$1" = "--since" ]; then since="${2#@}"; else until_="${2#@}"; tem_until=1; fi
            shift ;;
        -r) rev=1 ;;
        -n) limite="${2:-0}"; shift ;;
    esac
    shift
done
host=host; [ -f "$est/hostname-oom" ] && host=oom-kill-test
[ -f "$est/kernel-vazio" ] && exit 0
if [ -f "$est/kernel-seg" ]; then seg=$(cat "$est/kernel-seg")
elif [ -f "$est/kernel-horas" ]; then seg=$(( $(cat "$est/kernel-horas") * 3600 + 60 ))
else seg=$(( $(cat "$est/kernel-dias" 2>/dev/null || echo 9) * 86400 + 60 )); fi
boot=$((agora - seg))
saida="$(
    echo "$boot.000000 $host kernel: boot"
    [ -f "$est/kernel-extra" ] && while read -r n; do echo "$((agora - n)).000000 $host kernel: evento comum"; done <"$est/kernel-extra"
    [ -f "$est/kernel-msg" ] && while IFS= read -r m; do echo "$((agora - 120)).000000 $host $m"; done <"$est/kernel-msg"
    [ -f "$est/oom-seg" ] && echo "$((agora - $(cat "$est/oom-seg"))).000000 host kernel: Out of memory: Killed process 55 (node)"
    [ -f "$est/oom-host" ] && echo "$((agora - 60)).000000 host kernel: Out of memory: Killed process 77 (node)"
    [ -f "$est/kernel-oom-erro" ] && echo "$((agora - 60)).000000 $host kernel: Out of memory: Killed process 99 (node)"
)"
filtrado="$(printf '%s\n' "$saida" | sort -n | awk -v s="$since" -v u="$until_" '{ t = $1; sub(/\..*$/, "", t); if (t + 0 >= s + 0 && t + 0 <= u + 0) print }')"
if [ -n "$filtrado" ]; then
    [ "$rev" -eq 1 ] && filtrado="$(printf '%s\n' "$filtrado" | sort -rn)"
    [ "$limite" -gt 0 ] && filtrado="$(printf '%s\n' "$filtrado" | head -n "$limite")"
fi
if [ "$tem_until" -eq 0 ] && [ -f "$est/kernel-saida-erro" ]; then [ -z "$filtrado" ] || printf '%s\n' "$filtrado" | head -n 1; exit 1; fi
[ -z "$filtrado" ] || printf '%s\n' "$filtrado"
if [ "$tem_until" -eq 0 ]; then
    [ -f "$est/kernel-oom-erro" ] && exit 1
    [ -f "$est/journal-oom-grande" ] && { echo "$((agora - 60)).000000 host kernel: Out of memory: Killed process 4242 (chrome)"; head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
    [ -f "$est/journal-grande" ] && { head -c 1100000 /dev/zero | tr '\0' 'a'; exit 0; }
fi
exit 0
