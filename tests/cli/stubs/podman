#!/usr/bin/env bash
# podman de mentira: registra o argv e simula so o estado que os testes consultam.
echo "podman $*" >> "${STUB_LOG:?}"
est="${STUB_ESTADO:?}"
case "${1:-}" in
    image)
        # `image inspect -f {{.Id}}`: o id da imagem "atual" (muda quando o teste escreve estado/imagem-id).
        # Com .Labels: o label dgclaw.configuracao-administrada (presente por padrao; a flag sem-label o tira).
        if [ "$2" = inspect ] && printf '%s ' "$@" | grep -q '\.Labels'; then
            [ -f "$est/sem-label" ] || echo 1; exit 0
        fi
        if [ "$2" = inspect ]; then cat "$est/imagem-id" 2>/dev/null || echo imagem-nova; exit 0; fi
        [ "$2" = exists ] && [ ! -f "$est/sem-imagem" ]; exit $? ;;
    container)
        # `container inspect --format {{.ImageID}} <c>`: o id da imagem com que o container foi criado.
        if [ "$2" = inspect ]; then
            nome="${*: -1}"; [ -f "$est/c-$nome" ] || exit 1
            cat "$est/img-$nome" 2>/dev/null || echo imagem-velha; exit 0
        fi
        [ "$2" = exists ] && [ -f "$est/c-$3" ]; exit $? ;;
    network)
        case "$2" in
            exists) [ -f "$est/n-$3" ]; exit $? ;;
            create) touch "$est/n-${*: -1}"; echo "rede-id" ;;
            rm) rm -f "$est/n-$3" ;;
        esac ;;
    create)
        while [ $# -gt 0 ]; do [ "$1" = --name ] && nome="$2"; shift; done
        echo created > "$est/c-$nome"
        # O container nasce com a imagem que estava "atual" na hora (para o `agente recriar` comparar).
        cat "$est/imagem-id" 2>/dev/null > "$est/img-$nome" || echo imagem-nova > "$est/img-$nome"
        echo "container-id" ;;
    start)
        # Guarda o que estava gravado na pasta do runner na hora da partida (a ordem: regenerar antes de ligar).
        for f in managed-settings.json runner.json; do
            d="${DGCLAW_RAIZ:?}/var/lib/dgclaw/agentes/${2#dgclaw-}/runner/$f"
            if [ -f "$d" ]; then cp "$d" "$est/no-start-$f"; else rm -f "$est/no-start-$f"; fi
        done
        echo running > "$est/c-$2"
        # Simula o container que cai na partida (falta de inotify): estado exited, codigo 255.
        if [ -f "$est/saida-255" ]; then echo exited > "$est/c-$2"; echo 255 > "$est/codigo-$2"; fi ;;
    stop)
        nome="${*: -1}"
        [ -f "$est/c-$nome" ] || exit 0
        # stop-trava-<container> = N: o stop devolve, mas o estado fica "stopping" por N consultas
        # (depois vira exited); = sempre: fica "stopping" para sempre (o caso real do podman 4.9.3).
        if [ -f "$est/stop-trava-$nome" ]; then
            echo stopping > "$est/c-$nome"; cp "$est/stop-trava-$nome" "$est/stopping-resta-$nome"
        else echo exited > "$est/c-$nome"; fi ;;
    rm)
        nome="${*: -1}"; forca=0
        for a in "$@"; do [ "$a" = -f ] && forca=1; done
        # Como o podman de verdade: sem -f, nao remove container ligado ou parando.
        if [ -f "$est/c-$nome" ] && [ "$forca" = 0 ] && grep -qx 'running\|stopping' "$est/c-$nome"; then
            echo "Error: cannot remove container $nome as it is $(cat "$est/c-$nome") - running or paused containers cannot be removed without force: container state improper" >&2
            exit 2
        fi
        rm -f "$est/c-$nome" ;;
    inspect)
        nome="${*: -1}"
        [ -f "$est/c-$nome" ] || exit 1
        if printf '%s ' "$@" | grep -q '\.Mounts'; then
            if [ -f "$est/mounts-volume" ]; then echo "bind volume "; else echo "bind bind bind bind bind "; fi
            exit 0
        fi
        # Consulta de estado de um container "stopping": conta ate virar exited.
        if [ "$(cat "$est/c-$nome")" = stopping ] && [ -f "$est/stopping-resta-$nome" ]; then
            resta="$(cat "$est/stopping-resta-$nome")"
            if [ "$resta" != sempre ]; then
                if [ "$resta" -le 0 ]; then echo exited > "$est/c-$nome"; rm -f "$est/stopping-resta-$nome"
                else echo $((resta - 1)) > "$est/stopping-resta-$nome"; fi
            fi
        fi
        if printf '%s ' "$@" | grep -q '{{.Image}}'; then cat "$est/img-$nome" 2>/dev/null || echo imagem-velha; exit 0; fi
        if printf '%s ' "$@" | grep -q ExitCode; then
            printf '%s %s\n' "$(cat "$est/c-$nome")" "$(cat "$est/codigo-$nome" 2>/dev/null || echo 0)"
        else
            cat "$est/c-$nome"
        fi ;;
    exec)
        # `exec -i <container> bash -s` recebe o script por STDIN: guarda para o teste ler.
        if printf '%s ' "$@" | grep -q -- ' -i '; then cat >> "$STUB_LOG.stdin"; fi
        if printf '%s ' "$@" | grep -q is-system-running; then echo running; fi
        if [ "${*: -1}" = env ] && [ -f "$est/exec-proxy" ]; then echo "HTTPS_PROXY=http://127.0.0.1:3128"; fi
        if printf '%s ' "$@" | grep -q api.anthropic.com && [ -f "$est/sem-internet" ]; then
            echo "curl: (6) Could not resolve host: api.anthropic.com" >&2; exit 6
        fi
        # systemctl: restart-falha faz o restart falhar; inativo faz o is-active responder inactive.
        if printf '%s ' "$@" | grep -q 'systemctl restart' && [ -f "$est/restart-falha" ]; then
            echo "Job for dgclaw-runner.service failed (simulado)" >&2; exit 1
        fi
        if printf '%s ' "$@" | grep -q 'systemctl is-active'; then
            if [ -f "$est/inativo" ]; then echo inactive; exit 3; fi
            echo active; exit 0
        fi
        # exec como root, so leitura de /etc: a conferencia de suporte das restricoes (lib/restricoes.sh).
        # sem-suporte = imagem antiga (sem o link); ms-diferente = o link aponta para outro conteudo;
        # sem-script-gancho = a imagem nao traz o script do gancho de escrita.
        case "${3:-}" in
            readlink)
                [ -f "$est/sem-suporte" ] && exit 1
                echo /etc/dgclaw-runner/managed-settings.json; exit 0 ;;
            cat)
                if [ "${4:-}" = /etc/claude-code/managed-settings.json ]; then
                    [ -f "$est/sem-suporte" ] && exit 1
                    if [ -f "$est/ms-diferente" ]; then echo '{}'; exit 0; fi
                    cat "${DGCLAW_RAIZ:?}/var/lib/dgclaw/agentes/${2#dgclaw-}/runner/managed-settings.json"; exit $?
                fi ;;
            test)
                [ -f "$est/sem-script-gancho" ] && exit 1
                exit 0 ;;
        esac
        # `exec --user agente <c> node -e <script> <arquivo>`: roda o node de verdade, mas trocando
        # /home/agente pela casa do agente na raiz falsa (a caixa de mentira). `exec-node-nao` so registra.
        if [ "${2:-}" = "--user" ] && [ "${3:-}" = agente ] && [ "${5:-}" = node ] && [ ! -f "$est/exec-node-nao" ]; then
            slug="${4#dgclaw-}"; casa="${DGCLAW_RAIZ:?}/var/lib/dgclaw/agentes/$slug/home"
            # Leitura da politica remota (remote-settings.json): as flags montam o arquivo na casa do agente
            # e o node de verdade o le; sem flag, o arquivo some (sem-remota).
            if printf '%s ' "$@" | grep -q 'remote-settings.json'; then
                rs="$casa/.claude/remote-settings.json"; mkdir -p "$casa/.claude"; rm -f "$rs"
                if [ -f "$est/remota-com-chave" ]; then echo '{"permissions":{"deny":["Bash"]}}' > "$rs"
                elif [ -f "$est/remota-merge" ]; then echo '{"managedSourcesBehavior":"merge","permissions":{}}' > "$rs"
                elif [ -f "$est/remota-link" ]; then ln -s /etc/passwd "$rs"
                elif [ -f "$est/remota-invalida" ]; then echo '{nao e json' > "$rs"
                elif [ -f "$est/remota-vazia" ]; then echo '{}' > "$rs"
                fi
            fi
            shift 5; args=()
            for a in "$@"; do args+=("${a/#\/home\/agente/$casa}"); done
            # Alguns testes (atualizar) poem um node de mentira no PATH: aqui precisa ser o de verdade.
            PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '/stubs$' | paste -sd:)"
            exec node "${args[@]}"
        fi
        [ -f "$est/exec-falha" ] && exit 1
        exit 0 ;;
    build) echo "build simulado" ;;
esac
exit 0
