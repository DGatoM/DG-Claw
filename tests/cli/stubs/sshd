#!/usr/bin/env bash
# sshd de mentira: so o `sshd -T`. Imprime $STUB_ESTADO/sshd-T se existir; senao o padrao do OpenSSH
# (authorized_keys e authorized_keys2, sem AuthorizedKeysCommand). STUB_SSHD_FALHA=1 simula erro.
if [ -n "${STUB_SSHD_FALHA:-}" ]; then echo "sshd: erro simulado" >&2; exit 255; fi
if [ "${1:-}" = -T ]; then
    shift
    # `sshd -T -f <arquivo>`: a saida vem de <arquivo>.T (o que o sshd diria para aquela configuracao).
    if [ "${1:-}" = -f ] && [ -f "${2:-}.T" ]; then cat "$2.T"; exit 0; fi
    if [ -f "${STUB_ESTADO:?}/sshd-T" ]; then cat "$STUB_ESTADO/sshd-T"; exit 0; fi
    printf 'port 22\nauthorizedkeysfile .ssh/authorized_keys .ssh/authorized_keys2\nauthorizedkeyscommand none\n'
    exit 0
fi
if [ "${1:-}" = -t ]; then
    # `sshd -t [-f arquivo]`: valida a configuracao. STUB_SSHD_T_FALHA=1 simula configuracao invalida.
    if [ -n "${STUB_SSHD_T_FALHA:-}" ]; then echo "sshd: configuracao invalida (simulado)" >&2; exit 255; fi
    exit 0
fi
echo "sshd de mentira: so aceita -T (veio: $*)" >&2
exit 2
