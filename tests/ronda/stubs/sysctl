#!/usr/bin/env bash
echo "sysctl $*" >>"$STUB_DIR/chamadas.log"
case "$1" in
    -n) [ -f "$STUB_DIR/sysctl/$2" ] || { echo "sysctl: cannot stat /proc/sys/${2//.//}" >&2; exit 255; }; cat "$STUB_DIR/sysctl/$2" ;;
    -w) [ -f "$STUB_DIR/sysctl_recusa" ] && { echo "sysctl: setting key failed" >&2; exit 255; }
        k="${2%%=*}"; v="${2#*=}"; printf '%s\n' "$v" >"$STUB_DIR/sysctl/$k"
        # aplicar (valor 0) derruba o painel; voltar ao valor antigo (1) o recupera
        if [ -f "$STUB_DIR/quebra_ao_aplicar" ]; then
            if [ "$v" = 0 ]; then touch "$STUB_DIR/painel_cai"; else rm -f "$STUB_DIR/painel_cai"; fi
        fi ;;
esac
exit 0
