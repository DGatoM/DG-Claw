[Unit]
Description=DG Claw Tela do agente (navegador de verdade, com janela e CDP local)
After=dgclaw-tela.service
Requires=dgclaw-tela.service

[Service]
Type=simple
User=agente
Environment=HOME=/home/agente
Environment=DISPLAY=:1
# Perfil na casa do agente: as sessoes logadas sobrevivem a restart e viajam junto
# quando a casa for entregue ao cliente.
# As flags ficam no lancador. Sem headless de proposito: site com anti-robo recusa headless.
# CDP so em 127.0.0.1:9222: quem usa e o proprio agente (playwright connect_over_cdp).
# --no-sandbox: no podman com uidmap o sandbox do Chrome nao sobe (falta user namespace
# aninhado). O isolamento real e o do container, que ja separa o agente do servidor.
# Flags economicas: sem GPU, sem /dev/shm (o do container e pequeno), poucos renderers.
ExecStartPre=/usr/bin/rm -f /home/agente/.tela-chrome/SingletonLock /home/agente/.tela-chrome/SingletonSocket /home/agente/.tela-chrome/SingletonCookie
# O lancador escolhe o navegador (Google Chrome em amd64, Chromium do Playwright nas outras
# arquiteturas) e aplica as flags descritas nos comentarios acima.
ExecStart=/usr/local/bin/dgclaw-tela-navegador
# 78 = nenhum navegador na imagem: reiniciar de 5 em 5 segundos nao resolve.
RestartPreventExitStatus=78
# O systemd limita cada servico a 15% dos pids do container (153 com --pids-limit 1024), e o
# Chrome passa disso com duas abas: a aba nova morre com "pthread_create: Resource temporarily
# unavailable" e no CDP aparece "Target crashed". O --no-zygote acima poupa mais alguns.
TasksMax=600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
