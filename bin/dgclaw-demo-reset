#!/usr/bin/env bash
# dgclaw-demo-reset: prepara o agente do modo demonstração para um novo cliente (docs/MODO-DEMONSTRACAO.md).
# Roda como root, no host. É o que o botão "Novo cliente (Reset)" do painel chama, e também serve no terminal:
#
#   sudo dgclaw-demo-reset <slug> --dados <pasta-de-dados-do-painel-da-demonstracao> [--semente <pasta>] [--arquivo <pasta>]
#   sudo dgclaw-demo-reset <slug> --so-politica     (só instala e confere o bloqueio dos conectores do claude.ai)
#
# Ordem: trava, confere tudo ANTES de mexer, para o agente, MOVE (nunca apaga) o que é do cliente anterior para
# <arquivo>/<AAAAmmdd-HHMMSS>/, recoloca a semente, sobe o agente, espera o runner e confere o resultado.
# Cada etapa imprime uma linha "==> ..." que o painel mostra como andamento. Falhou: sai diferente de 0 e escreve o motivo.
#
# Bloqueio dos conectores do claude.ai (Gmail, Agenda, Drive...): depois de ligar o agente, o reset instala
# /etc/claude-code/managed-settings.json DENTRO do container (root, 644) a partir de templates/demo/managed-settings.json,
# e a conferência final reprova se o arquivo não estiver lá com o conteúdo certo (sha256).
#
# Sem sudo para o agente: o container da imagem dá ao agente `NOPASSWD:ALL`, e com isso ele apagaria a política acima.
# No modo demonstração o reset move /etc/sudoers.d/agente para /etc/sudoers.d/.agente-demo-desligado (nunca apaga; o sudo
# ignora arquivos com ponto no nome) e a conferência final reprova se `sudo -n true` ainda funcionar para o agente.
# Se instalar a política ou tirar o sudo falhar com o agente ligado, o script PARA o agente e sai com falha.
#
# Travas: --dados é obrigatório, não pode ser a pasta do painel principal (/var/lib/dgclaw/web) e precisa ter a marca
# <dados>/demo/INSTANCIA gravada pelo painel da demonstração (com o slug do agente). O reset completo só roda se for chamado
# pelo painel (DGCLAW_DEMO_PELO_PAINEL=1) ou se o painel daquela instância estiver parado (systemctl is-active
# dgclaw-demo@<instancia>, ou a unidade em DGCLAW_DEMO_UNIDADE); senão o painel não saberia do reset.
#
# Não toca: AGENT.md, CLAUDE.md, identidade, skills, login (.claude/.credentials.json) e cofre.
#
# Variáveis (para testes): DGCLAW_RAIZ (prefixo falso de /etc e /var), DGCLAW_CLI (o comando dgclaw),
# DGCLAW_DEMO_ESPERA (segundos esperando o runner), DGCLAW_DEMO_URL_RUNNER (ignora o agentes.json),
# DGCLAW_PODMAN (o comando podman), DGCLAW_DEMO_POLITICA (o modelo do managed-settings.json),
# DGCLAW_DEMO_PELO_PAINEL (1 quando o painel chama), DGCLAW_DEMO_UNIDADE (a unidade systemd do painel da demonstração).
set -euo pipefail
umask 077

RAIZ="${DGCLAW_RAIZ:-}"
CLI="${DGCLAW_CLI:-dgclaw}"
ESPERA="${DGCLAW_DEMO_ESPERA:-90}"
PODMAN="${DGCLAW_PODMAN:-podman}"
POLITICA_MODELO="${DGCLAW_DEMO_POLITICA:-$(dirname "$(readlink -f "$0")")/../templates/demo/managed-settings.json}"
POLITICA_CAMINHO=/etc/claude-code/managed-settings.json
# sha256 do conteúdo exato que o modelo precisa ter (um modelo editado por engano não chega ao agente).
POLITICA_SHA=e51153f24e4df52e977f6dfe2fccbed809bd279b001258772fbbe879a1b76f7e
SO_POLITICA=0
LIGADO=0
APOS_PARAR=0
PROTEGER=0
SUDO_DESLIGADO=/etc/sudoers.d/.agente-demo-desligado

passo() { printf '==> %s\n' "$*"; }
falha() { printf 'ERRO: %s\n' "$*" >&2; exit 1; }
uso() {
    cat >&2 <<'FIM'
Uso: dgclaw-demo-reset <slug> --dados <pasta>  [--semente <pasta>] [--arquivo <pasta>] [--so-politica]
  slug      o agente da demonstração (minúsculas, números e hífen, até 32 caracteres)
  --dados   OBRIGATÓRIO (menos com --so-politica): pasta de dados do painel da demonstração, com a marca demo/INSTANCIA
  --semente pasta com o que volta para a casa do agente (padrão: /var/lib/dgclaw/demo-semente/<slug>)
  --arquivo pasta onde o que saiu fica guardado (padrão: /var/lib/dgclaw/demo-arquivo/<slug>)
  --so-politica só instala e confere o bloqueio dos conectores do claude.ai no container (não move nada, não para o agente)
FIM
    exit 1
}

[ $# -ge 1 ] || uso
SLUG="$1"; shift
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || falha "o slug \"$SLUG\" não vale: use minúsculas, números e hífen, até 32 caracteres, começando por letra ou número."

DADOS=""
SEMENTE="$RAIZ/var/lib/dgclaw/demo-semente/$SLUG"
ARQUIVO_BASE="$RAIZ/var/lib/dgclaw/demo-arquivo/$SLUG"
while [ $# -gt 0 ]; do
    case "$1" in
        --dados|--semente|--arquivo)
            [ $# -ge 2 ] || falha "falta o valor depois de $1."
            case "$1" in --dados) DADOS="$2" ;; --semente) SEMENTE="$2" ;; --arquivo) ARQUIVO_BASE="$2" ;; esac
            shift 2 ;;
        --so-politica) SO_POLITICA=1; shift ;;
        *) uso ;;
    esac
done

if [ "$SO_POLITICA" = 0 ]; then
    [ -n "$DADOS" ] || falha "falta --dados <pasta de dados do painel da demonstração>. Sem ele eu poderia mexer na Mesa, nos lembretes e nos alertas de outros agentes. Nada foi mexido."
    [ -d "$DADOS" ] || falha "a pasta de dados do painel $DADOS não existe. Passe --dados com a pasta certa. Nada foi mexido."
    if [ "$(readlink -f "$DADOS")" = "$(readlink -f "$RAIZ/var/lib/dgclaw/web")" ]; then
        falha "--dados aponta para $DADOS, que é a pasta do painel principal (Mesa, lembretes e alertas de todos os agentes). O reset da demonstração nunca mexe nela. Use a pasta de dados do painel da demonstração. Nada foi mexido."
    fi
    MARCA="$DADOS/demo/INSTANCIA"
    [ -f "$MARCA" ] && [ ! -L "$MARCA" ] || falha "a pasta $DADOS não tem a marca do modo demonstração ($MARCA). Ela só existe na pasta de dados de um painel que roda o modo demonstração. Confira o --dados. Nada foi mexido."
    [ "$(sed -n 1p "$MARCA")" = "$SLUG" ] || falha "a marca $MARCA é do agente \"$(sed -n 1p "$MARCA" | cut -c1-40)\", e o reset é do agente \"$SLUG\". Confira o slug e o --dados. Nada foi mexido."
    INSTANCIA="$(sed -n 2p "$MARCA" | sed -n 's/^instancia=//p')"
    [[ "$INSTANCIA" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || INSTANCIA="$SLUG"
    UNIDADE="${DGCLAW_DEMO_UNIDADE:-dgclaw-demo@$INSTANCIA}"
    if [ "${DGCLAW_DEMO_PELO_PAINEL:-}" != 1 ]; then
        if ! command -v systemctl >/dev/null; then
            falha "este reset só roda pelo botão \"Novo cliente (Reset)\" do painel, porque o painel precisa saber que ele está acontecendo, e não consegui conferir se o painel está parado (falta o systemctl). Use o botão. Nada foi mexido."
        fi
        if systemctl is-active --quiet "$UNIDADE"; then
            falha "o painel da demonstração ($UNIDADE) está rodando, e ele não saberia deste reset: ele continuaria aceitando pedidos e cartões do cliente anterior. Faça o Reset pelo botão \"Novo cliente (Reset)\" do painel, ou pare o painel antes (systemctl stop $UNIDADE) e rode de novo. Nada foi mexido."
        fi
    fi
fi

CASA="$RAIZ/var/lib/dgclaw/agentes/$SLUG/home"
AGENTES_JSON="$RAIZ/etc/dgclaw/agentes.json"
PASTA_TRAVA="$RAIZ/var/lock"

for ferramenta in flock stat find cp mv chown; do
    command -v "$ferramenta" >/dev/null || falha "o programa $ferramenta não foi encontrado neste servidor. Instale-o (pacote coreutils/util-linux) e tente de novo."
done

# container_do_agente: o nome do container vem do registro (campo "container"), o mesmo que o dgclaw usa para parar e ligar.
container_do_agente() {
    command -v jq >/dev/null || falha "o jq não foi encontrado: preciso dele para ler o container de $SLUG no agentes.json. Instale com: apt install jq"
    [ -r "$AGENTES_JSON" ] || falha "não consegui ler $AGENTES_JSON. Nada foi mexido."
    CONTAINER="$(jq -r --arg s "$SLUG" '.agentes[] | select(.slug == $s) | .container // empty' "$AGENTES_JSON")"
    [ -n "$CONTAINER" ] || falha "o agente $SLUG não tem o campo \"container\" no $AGENTES_JSON, então não sei onde instalar o bloqueio dos conectores do claude.ai. Nada foi mexido."
}

confere_modelo_da_politica() {
    [ -r "$POLITICA_MODELO" ] || falha "não achei o modelo do bloqueio dos conectores do claude.ai em $POLITICA_MODELO. Reinstale o DG Claw. Nada foi mexido."
    command -v sha256sum >/dev/null || falha "o programa sha256sum não foi encontrado neste servidor (pacote coreutils). Nada foi mexido."
    [ "$(sha256sum <"$POLITICA_MODELO" | cut -d' ' -f1)" = "$POLITICA_SHA" ] \
        || falha "o modelo $POLITICA_MODELO não tem o conteúdo esperado (sha256 diferente). Restaure-o com: git checkout -- templates/demo/managed-settings.json. Nada foi mexido."
}

# instala_politica: grava $POLITICA_CAMINHO dentro do container, como root, dono root e modo 644. Vai por STDIN
# (podman exec -i): o podman cp quebra com "value too large for defined data type" quando o mapa de uid é alto
# (mesmo motivo do vida_script, no bin/dgclaw).
instala_politica() {
    passo "Instalando o bloqueio dos conectores do claude.ai no container $CONTAINER"
    "$PODMAN" exec -i -u 0 "$CONTAINER" sh -c 'set -e; umask 022; mkdir -p /etc/claude-code; cat > /etc/claude-code/managed-settings.json.novo; chown 0:0 /etc/claude-code/managed-settings.json.novo; chmod 644 /etc/claude-code/managed-settings.json.novo; mv -f /etc/claude-code/managed-settings.json.novo /etc/claude-code/managed-settings.json' <"$POLITICA_MODELO" \
        || falha "não consegui instalar $POLITICA_CAMINHO dentro do container $CONTAINER. Sem ele, os conectores do claude.ai (Gmail e outros) ficam abertos para o agente. Confira se o container está ligado: $PODMAN ps"
}

# tira_sudo: o agente da imagem tem `NOPASSWD:ALL` em /etc/sudoers.d/agente. O arquivo é MOVIDO (nunca apagado) para um
# nome com ponto, que o sudo não lê.
tira_sudo() {
    passo "Tirando o sudo do agente no container $CONTAINER"
    "$PODMAN" exec -i -u 0 "$CONTAINER" sh -c 'set -e; if [ -e /etc/sudoers.d/agente ]; then mv -f /etc/sudoers.d/agente /etc/sudoers.d/.agente-demo-desligado; fi' \
        || falha "não consegui tirar o sudo do agente dentro do container $CONTAINER. Sem isso o agente apagaria o bloqueio dos conectores do claude.ai."
}

confere_sem_sudo() {
    "$PODMAN" exec -u agente "$CONTAINER" true >/dev/null 2>&1 \
        || falha "não consegui rodar um comando como o usuário agente no container $CONTAINER, então não consigo conferir que ele está sem sudo. Confira se o container está ligado: $PODMAN ps"
    if "$PODMAN" exec -u agente "$CONTAINER" sudo -n true >/dev/null 2>&1; then
        falha "o agente ainda consegue usar sudo no container $CONTAINER: ele poderia apagar o bloqueio dos conectores do claude.ai. Rode: dgclaw-demo-reset $SLUG --so-politica"
    fi
}

confere_politica() {
    local real dono
    real="$("$PODMAN" exec -u 0 "$CONTAINER" sha256sum "$POLITICA_CAMINHO" 2>/dev/null | cut -d' ' -f1)" || real=""
    [ -n "$real" ] || falha "não achei $POLITICA_CAMINHO dentro do container $CONTAINER: os conectores do claude.ai estariam abertos. Rode: dgclaw-demo-reset $SLUG --so-politica"
    [ "$real" = "$POLITICA_SHA" ] || falha "$POLITICA_CAMINHO no container $CONTAINER não tem o conteúdo certo (sha256 $real, esperado $POLITICA_SHA): os conectores do claude.ai podem estar abertos. Rode: dgclaw-demo-reset $SLUG --so-politica"
    dono="$("$PODMAN" exec -u 0 "$CONTAINER" stat -c '%U:%G %a' "$POLITICA_CAMINHO" 2>/dev/null)" || dono=""
    [ "$dono" = "root:root 644" ] || falha "$POLITICA_CAMINHO no container $CONTAINER está com dono/permissão '${dono:-desconhecido}' e precisa ser 'root:root 644' (o agente não pode poder trocá-lo). Rode: dgclaw-demo-reset $SLUG --so-politica"
}

ao_falhar() {
    if [ "$LIGADO" = 1 ]; then
        printf 'O agente %s está LIGADO, mas o reset não terminou (motivo acima). O que já foi movido está em %s. Corrija o motivo e rode o reset de novo.\n' "$SLUG" "$DESTINO" >&2
        return
    fi
    printf 'O agente %s ficou PARADO. O que já foi movido está em %s. Corrija o motivo acima e rode o reset de novo (ou ligue o agente com: %s agente iniciar %s).\n' "$SLUG" "$DESTINO" "$CLI" "$SLUG" >&2; }
# Falhou a proteção (política dos conectores ou retirada do sudo) com o agente ligado: o agente é PARADO, porque ligado
# e sem proteção ele alcançaria o Gmail, a Agenda e o Drive do dono.
para_por_protecao() {
    if "$CLI" agente parar "$SLUG" >/dev/null 2>&1; then
        printf 'O agente %s ficou PARADO de propósito: a proteção do modo demonstração (bloqueio dos conectores do claude.ai e agente sem sudo) não ficou garantida, e ligado ele poderia alcançar os conectores do dono. Corrija o motivo acima, rode "dgclaw-demo-reset %s --so-politica" para refazer a proteção e ligue o agente com: %s agente iniciar %s\n' "$SLUG" "$SLUG" "$CLI" "$SLUG" >&2
    else
        printf 'ATENÇÃO: a proteção do modo demonstração não ficou garantida e eu NÃO consegui parar o agente %s. Pare-o agora, à mão: %s agente parar %s\n' "$SLUG" "$CLI" "$SLUG" >&2
    fi
}
ao_sair() {
    local rc=$?
    [ "$rc" -ne 0 ] || return 0
    if [ "${PROTEGER:-0}" = 1 ]; then para_por_protecao; elif [ "${APOS_PARAR:-0}" = 1 ]; then ao_falhar; fi
}

# Só o bloqueio: confere, instala e confere de novo. Não para o agente, não move nada.
if [ "$SO_POLITICA" = 1 ]; then
    container_do_agente
    confere_modelo_da_politica
    trap ao_sair EXIT
    PROTEGER=1
    instala_politica
    tira_sudo
    passo "Conferindo o bloqueio dos conectores do claude.ai e o sudo"
    confere_politica
    confere_sem_sudo
    PROTEGER=0
    passo "Pronto: o bloqueio dos conectores do claude.ai está em $POLITICA_CAMINHO dentro de $CONTAINER, e o agente está sem sudo"
    exit 0
fi

mkdir -p "$PASTA_TRAVA" 2>/dev/null || PASTA_TRAVA="${TMPDIR:-/tmp}"
exec 9>"$PASTA_TRAVA/dgclaw-demo-reset-$SLUG.lock"
flock -n 9 || falha "já existe um reset do agente $SLUG em andamento. Espere terminar."

# ── conferências antes de mexer em qualquer coisa ──────────────────────────
passo "Conferindo o agente e a semente"
if [ ! -d "$CASA" ] || [ -L "$CASA" ]; then falha "a casa do agente $SLUG não existe (ou é um atalho): $CASA. Confira o slug com: dgclaw agente listar"; fi
if [ ! -d "$SEMENTE" ] || [ -L "$SEMENTE" ]; then falha "falta a pasta de semente $SEMENTE. Crie-a com o que o agente deve ter no começo de cada cliente (pode ficar vazia) e rode de novo. Nada foi mexido."; fi
if [ -n "$(find "$SEMENTE" -type l -print -quit)" ]; then
    falha "a semente $SEMENTE tem atalhos (links simbólicos) e eu não os copio. Troque-os por arquivos de verdade. Nada foi mexido."
fi
for proibido in AGENT.md CLAUDE.md .claude/.credentials.json .claude/skills .plataforma/identidade.md .plataforma/segredos; do
    [ ! -e "$SEMENTE/$proibido" ] || falha "a semente tem $proibido, que o reset nunca troca (identidade, skills e login não saem). Tire-o da semente. Nada foi mexido."
done

container_do_agente
confere_modelo_da_politica

DONO_UID="$(stat -c '%u' "$CASA")"
DONO_GID="$(stat -c '%g' "$CASA")"

URL_RUNNER="${DGCLAW_DEMO_URL_RUNNER:-}"
if [ -z "$URL_RUNNER" ]; then
    command -v jq >/dev/null || falha "o jq não foi encontrado: preciso dele para ler o runner de $SLUG no agentes.json. Instale com: apt install jq"
    [ -r "$AGENTES_JSON" ] || falha "não consegui ler $AGENTES_JSON. Nada foi mexido."
    URL_RUNNER="$(jq -r --arg s "$SLUG" '.agentes[] | select(.slug == $s) | .runner // empty' "$AGENTES_JSON")"
    [ -n "$URL_RUNNER" ] || falha "o agente $SLUG não está no $AGENTES_JSON. Nada foi mexido."
fi

mkdir -p "$ARQUIVO_BASE"
chmod 700 "$(dirname "$ARQUIVO_BASE")" "$ARQUIVO_BASE"
if [ "$(id -u)" = 0 ]; then chown 0:0 "$(dirname "$ARQUIVO_BASE")" "$ARQUIVO_BASE"; fi
# mv só é seguro (um rename, nunca copia e apaga) dentro do mesmo disco.
for origem in "$CASA" "$DADOS"; do
    [ "$(stat -c '%d' "$origem")" = "$(stat -c '%d' "$ARQUIVO_BASE")" ] \
        || falha "$origem e a pasta de arquivo $ARQUIVO_BASE estão em discos diferentes. Para não correr o risco de perder dados, o reset não copia entre discos: aponte --arquivo para uma pasta do mesmo disco. Nada foi mexido."
done

ESTAMPA="$(date +%Y%m%d-%H%M%S)"
DESTINO="$ARQUIVO_BASE/$ESTAMPA"
n=1
while [ -e "$DESTINO" ]; do n=$((n + 1)); DESTINO="$ARQUIVO_BASE/$ESTAMPA-$n"; done
mkdir -m 700 "$DESTINO"

SESSAO_ANTIGA=""
if [ -r "$CASA/.plataforma/runner-state.json" ] && command -v jq >/dev/null; then
    SESSAO_ANTIGA="$(jq -r '.sessionId // empty' "$CASA/.plataforma/runner-state.json" 2>/dev/null || true)"
fi

# ── para o agente ──────────────────────────────────────────────────────────
passo "Parando o agente $SLUG"
"$CLI" agente parar "$SLUG" >/dev/null || falha "não consegui parar o agente $SLUG. Nada foi movido. Tente: $CLI agente parar $SLUG"

APOS_PARAR=1
trap ao_sair EXIT
MOVIDOS="$DESTINO/MANIFESTO.txt"
: >"$MOVIDOS"

# Devolve 0 se nenhum componente do caminho relativo (a partir de <base>) é atalho. O agente escreve na casa dele,
# então um atalho no meio do caminho faria o root mexer fora dela.
sem_atalho() {
    local base="$1" rel="$2" atual="$1" parte
    local IFS=/
    for parte in $rel; do
        atual="$atual/$parte"
        if [ -L "$atual" ]; then return 1; fi
        [ -e "$atual" ] || return 0
    done
    return 0
}

# mover <base> <rel> <destino-sub>: move <base>/<rel> para <DESTINO>/<destino-sub>/<rel>; recria pasta vazia com o mesmo dono.
mover() {
    local base="$1" rel="$2" sub="$3" origem="$1/$2" alvo
    [ -e "$origem" ] || [ -L "$origem" ] || return 0
    sem_atalho "$base" "$rel" || falha "o caminho $rel dentro de $base passa por um atalho (link simbólico); por segurança não o movo. Remova o atalho e rode de novo."
    alvo="$DESTINO/$sub/$rel"
    mkdir -p "$(dirname "$alvo")"
    local era_pasta=0 modo="" dono=""
    if [ -d "$origem" ] && [ ! -L "$origem" ]; then era_pasta=1; modo="$(stat -c '%a' "$origem")"; dono="$(stat -c '%u:%g' "$origem")"; fi
    mv -- "$origem" "$alvo" || falha "não consegui mover $origem para $alvo."
    if { [ ! -e "$alvo" ] && [ ! -L "$alvo" ]; } || [ -e "$origem" ] || [ -L "$origem" ]; then
        falha "depois de mover $origem, o arquivo não está inteiro em $alvo (ou ainda está na origem). Pare e confira à mão."
    fi
    printf '%s/%s\n' "$sub" "$rel" >>"$MOVIDOS"
    if [ "$era_pasta" = 1 ]; then
        mkdir -m "$modo" "$origem"
        chown "$dono" "$origem"
    fi
}

# Históricos de sessão dos dois motores (Claude Code e Codex, assinatura e API). Cada nome abaixo existe dentro de uma
# "raiz de configuração": <casa>/.claude, <casa>/.codex e uma por sessão em <casa>/.plataforma/codex-api/<id>
# (runner/src/provedores/codex.ts: codexHomeDe). As credenciais (.credentials.json, auth.json, .dgclaw-chave.sha256)
# ficam de fora de propósito.
NOMES_CLAUDE=(projects todos shell-snapshots file-history history.jsonl session-env plans tasks debug)
NOMES_CODEX=(sessions archived_sessions history.jsonl log shell_snapshots memories 'state_*.sqlite*' 'logs_*.sqlite*')

# historicos: imprime (um por linha) o caminho relativo à casa de cada histórico que existe agora.
historicos() {
    local raiz nome alvo
    local -a raizes=()
    local id
    raizes+=(".claude:C" ".codex:X")
    if [ -d "$CASA/.plataforma/codex-api" ] && [ ! -L "$CASA/.plataforma/codex-api" ]; then
        while IFS= read -r -d '' id; do raizes+=(".plataforma/codex-api/$(basename "$id"):X"); done \
            < <(find "$CASA/.plataforma/codex-api" -mindepth 1 -maxdepth 1 -print0)
    fi
    for raiz in "${raizes[@]}"; do
        local rel="${raiz%:*}" tipo="${raiz##*:}"
        local -a nomes
        if [ "$tipo" = C ]; then nomes=("${NOMES_CLAUDE[@]}"); else nomes=("${NOMES_CODEX[@]}"); fi
        for nome in "${nomes[@]}"; do
            # o nome pode ter curinga; a expansão é feita aqui, dentro da raiz
            for alvo in "$CASA/$rel"/$nome; do
                if [ -e "$alvo" ] || [ -L "$alvo" ]; then printf '%s\n' "${alvo#"$CASA"/}"; fi
            done
        done
    done
}

# Cópias de conteúdo do cliente anterior que o painel e o agente guardam na casa fora das pastas acima:
# as cópias da memória feitas a cada edição (panel/lib/memoria.js), o registro das edições, o histórico da sessão de
# socorro (panel/lib/socorro.js) e o registro das sessões paralelas (panel/lib/sessoes-local.js). São movidas, nunca
# apagadas. Ficam de fora de propósito: .dgclaw/demo.token, demo.url, crm.key e a configuração da tela/VNC.
COPIAS_DE_CONTEUDO=(.dgclaw/backups .dgclaw/socorro .dgclaw/logs/edicoes-memoria.jsonl .dgclaw/panel/sessoes-local.json)

passo "Guardando a conversa e a memória do cliente anterior em $DESTINO"
while IFS= read -r rel; do
    mover "$CASA" "$rel" casa
done < <(historicos)
for rel in memory MEMORY.md working-memory.md arquivos saida uploads crm data planning \
           .dgclaw/memory_index .dgclaw/retratos .cache \
           "${COPIAS_DE_CONTEUDO[@]}" \
           .plataforma/runner-state.json .plataforma/sessoes-extras.json .plataforma/dgchat .plataforma/fila-ocioso; do
    mover "$CASA" "$rel" casa
done
for rel in demo/cartoes mesa lembretes alertas; do
    mover "$DADOS" "$rel" web
done

# ── semente ────────────────────────────────────────────────────────────────
# A semente nunca é copiada por cima da casa: o agente escreve na casa e pode ter plantado atalhos (links simbólicos)
# onde a semente tem arquivo, e o root seguiria o atalho para fora. Então ela é copiada para uma pasta nova, criada
# aqui (700, no mesmo disco), e cada item é MOVIDO (rename) para o lugar dele. O que já estava no lugar (atalho,
# arquivo ou pasta) vai antes para o arquivo, nunca é apagado nem atravessado.
passo "Recolocando a semente"
PREPARO="$(mktemp -d "$CASA/.dgclaw-semente.XXXXXX")" || falha "não consegui criar a pasta de preparo da semente dentro de $CASA."
chmod 700 "$PREPARO"
cp -R --no-dereference --preserve=mode,timestamps -- "$SEMENTE/." "$PREPARO/" || falha "não consegui copiar a semente $SEMENTE para $PREPARO."
chown -hR "$DONO_UID:$DONO_GID" -- "$PREPARO" || falha "não consegui dar à semente preparada o dono do agente ($DONO_UID:$DONO_GID)."

# guarda_ocupante <alvo> <rel>: tira do caminho (para o arquivo) o que está em <alvo>, atalho ou não.
guarda_ocupante() {
    local alvo="$1" rel="$2" guardado="$DESTINO/casa-substituido/$2"
    [ -e "$alvo" ] || [ -L "$alvo" ] || return 0
    mkdir -p "$(dirname "$guardado")"
    [ ! -e "$guardado" ] && [ ! -L "$guardado" ] || falha "já existe $guardado no arquivo; não sobrescrevo. Confira à mão."
    mv -- "$alvo" "$guardado" || falha "não consegui guardar $alvo em $guardado."
    printf 'casa-substituido/%s\n' "$rel" >>"$MOVIDOS"
}

# Só estas pastas de topo têm coisa que o reset não troca (login, skills, identidade do ambiente); nelas a semente é
# fundida item a item. Qualquer outra entrada de topo da semente (dados/, plano-b/, ...) substitui a pasta INTEIRA:
# o que o agente mexeu nela durante a reunião vai para o arquivo.
eh_pasta_de_config() { case "$1" in .claude|.codex|.plataforma) return 0 ;; *) return 1 ;; esac; }

# funde <pasta-preparada> <pasta-da-casa> <rel>: só desce em pasta de verdade de config; todo o resto é guardado e substituído.
funde() {
    local de="$1" para="$2" rel="$3" item nome alvo
    while IFS= read -r -d '' item; do
        nome="$(basename "$item")"
        alvo="$para/$nome"
        if [ -d "$item" ] && [ ! -L "$item" ] && [ -d "$alvo" ] && [ ! -L "$alvo" ] && { [ -n "$rel" ] || eh_pasta_de_config "$nome"; }; then
            funde "$item" "$alvo" "${rel:+$rel/}$nome"
            rmdir -- "$item" 2>/dev/null || true
            continue
        fi
        guarda_ocupante "$alvo" "${rel:+$rel/}$nome"
        mv -- "$item" "$alvo" || falha "não consegui colocar $nome da semente em $para."
    done < <(find "$de" -mindepth 1 -maxdepth 1 -print0)
}
funde "$PREPARO" "$CASA" ""
rmdir -- "$PREPARO" || falha "sobrou coisa na pasta de preparo $PREPARO. Confira à mão."
for pasta in arquivos saida memory; do
    if [ ! -e "$CASA/$pasta" ]; then mkdir -m 755 "$CASA/$pasta"; chown "$DONO_UID:$DONO_GID" "$CASA/$pasta"; fi
done

# ── sobe e confere ─────────────────────────────────────────────────────────
passo "Ligando o agente $SLUG"
"$CLI" agente iniciar "$SLUG" >/dev/null || falha "não consegui ligar o agente $SLUG. Veja: $CLI agente iniciar $SLUG"
LIGADO=1
PROTEGER=1
instala_politica
tira_sudo
PROTEGER=0

passo "Esperando o runner responder"
pronto=0
for ((i = 0; i < ESPERA; i++)); do
    if curl -fsS --max-time 3 "$URL_RUNNER/api/saude" >/dev/null 2>&1; then pronto=1; break; fi
    sleep 1
done
[ "$pronto" = 1 ] || falha "o runner não respondeu em ${ESPERA}s em $URL_RUNNER/api/saude. Veja o log com: podman exec dgclaw-$SLUG journalctl -u dgclaw-runner -n 50"

passo "Conferindo o resultado"
if [ -n "$(find "$CASA/.claude/projects" -name '*.jsonl' -print -quit 2>/dev/null)" ]; then
    falha "ainda há uma conversa antiga (arquivo .jsonl) em $CASA/.claude/projects."
fi
while IFS= read -r rel; do
    [ ! -e "$SEMENTE/$rel" ] || continue
    if [ -d "$CASA/$rel" ] && [ ! -L "$CASA/$rel" ]; then
        [ -z "$(find "$CASA/$rel" -type f -print -quit 2>/dev/null)" ] || falha "ainda há histórico de sessão do cliente anterior em $CASA/$rel."
    elif [ -s "$CASA/$rel" ] || [ -L "$CASA/$rel" ]; then
        falha "ainda há histórico de sessão do cliente anterior em $CASA/$rel."
    fi
done < <(historicos)
for rel in "${COPIAS_DE_CONTEUDO[@]}"; do
    [ -e "$SEMENTE/$rel" ] && continue
    if [ -d "$CASA/$rel" ] && [ ! -L "$CASA/$rel" ]; then
        [ -z "$(find "$CASA/$rel" -type f -print -quit 2>/dev/null)" ] || falha "ainda há cópia de conteúdo do cliente anterior em $CASA/$rel."
    elif [ -e "$CASA/$rel" ] || [ -L "$CASA/$rel" ]; then
        falha "ainda há cópia de conteúdo do cliente anterior em $CASA/$rel."
    fi
done
[ ! -e "$CASA/.claude/history.jsonl" ] || [ ! -s "$CASA/.claude/history.jsonl" ] || falha "o histórico antigo de comandos ainda está em $CASA/.claude/history.jsonl."
if [ -d "$CASA/memory" ]; then
    while IFS= read -r -d '' arq; do
        rel="${arq#"$CASA"/}"
        [ -e "$SEMENTE/$rel" ] || falha "há memória que não veio da semente em $arq. O agente pode ter começado a escrever antes da conferência; rode o reset de novo."
    done < <(find "$CASA/memory" -type f -print0)
fi
# toda entrada de topo da semente (fora as pastas de config) tem que ser exatamente a da semente.
while IFS= read -r -d '' item; do
    nome="$(basename "$item")"
    eh_pasta_de_config "$nome" && continue
    [ ! -L "$CASA/$nome" ] || falha "$CASA/$nome é um atalho depois da semente."
    [ -e "$CASA/$nome" ] || falha "a semente trouxe $nome mas ele não está em $CASA."
    if [ -d "$CASA/$nome" ]; then
        while IFS= read -r -d '' arq; do
            rel="${arq#"$CASA"/}"
            [ -e "$SEMENTE/$rel" ] || [ -d "$arq" ] || falha "há um item que não veio da semente em $arq. Ele devia ter ido para o arquivo; rode o reset de novo."
        done < <(find "$CASA/$nome" -mindepth 1 \( -type f -o -type l \) -print0)
    fi
done < <(find "$SEMENTE" -mindepth 1 -maxdepth 1 -print0)
for rel in MEMORY.md working-memory.md; do
    if [ -e "$CASA/$rel" ] && [ ! -e "$SEMENTE/$rel" ]; then falha "o arquivo $rel antigo continua em $CASA."; fi
done
if [ -n "$SESSAO_ANTIGA" ] && [ -r "$CASA/.plataforma/runner-state.json" ] && command -v jq >/dev/null; then
    nova="$(jq -r '.sessionId // empty' "$CASA/.plataforma/runner-state.json" 2>/dev/null || true)"
    [ "$nova" != "$SESSAO_ANTIGA" ] || falha "o runner continua com a sessão antiga ($SESSAO_ANTIGA): a próxima conversa retomaria o cliente anterior."
fi
while IFS= read -r item; do
    [ -e "$DESTINO/$item" ] || [ -L "$DESTINO/$item" ] || falha "o arquivo de $DESTINO não tem $item, que devia ter saído. Confira à mão antes de seguir."
done <"$MOVIDOS"
for rel in AGENT.md CLAUDE.md; do
    [ ! -e "$DESTINO/casa/$rel" ] || falha "$rel foi parar no arquivo, e ele não devia sair da casa. Recoloque-o a partir de $DESTINO/casa/$rel."
done

passo "Conferindo o bloqueio dos conectores do claude.ai e o sudo do agente"
PROTEGER=1
confere_politica
confere_sem_sudo
PROTEGER=0

APOS_PARAR=0
passo "Pronto: $(wc -l <"$MOVIDOS" | tr -d ' ') itens guardados em $DESTINO"
