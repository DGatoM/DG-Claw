#!/usr/bin/env bash
# dgclaw-card: o agente abre um "card" em outro provedor (ex.: uma sessao Codex/GPT enquanto ele
# e Claude), manda um pedido, espera, le a resposta e fecha. Roda DENTRO do container, como "agente".
#
# Uso:
#   dgclaw-card abrir --provedor codex|claude [--auth assinatura|api|token] [--modelo M] --titulo "T"
#                     (--pedido "texto" | --pedido-arquivo F | pedido pelo stdin)
#                     [--monitor --entregue "criterio de entregue" [--cada MIN]]
#                     [--espera-turno SEG]
#                     --espera-turno: depois de entregar o pedido, o "abrir" espera ate SEG segundos (padrao 60,
#                     de 0 a 3600; 0 desliga) o pedido virar o primeiro turno do card. Sem turno, sai com 9.
#                     O id do card sai UMA vez, na primeira linha do stdout, assim que a criacao e confirmada,
#                     mesmo quando o "abrir" termina com 8, 9, 11 ou 12. Com codigo diferente de 0, nao siga
#                     adiante com o id: confira com "estado" e "ler".
#                     --monitor liga o MODO MONITOR neste card (docs/MODO-MONITOR.md): um vigia sem modelo
#                     que so acorda voce quando o card para, pede algo, trava ou erra. --entregue e
#                     obrigatorio com --monitor; --cada e o intervalo em minutos (padrao 10).
#   dgclaw-card mandar <id> (texto | --arquivo F | stdin)
#   dgclaw-card estado <id>
#   dgclaw-card esperar <id> [--max SEGUNDOS]        (padrao 900; olha a cada 5 s)
#   dgclaw-card ler <id> [--n N]                     (padrao 4 mensagens)
#   dgclaw-card listar                               (so os cards criados por esta via)
#   dgclaw-card fechar <id> [--forcar]               (card sem nenhum turno: pede --forcar)
#   dgclaw-card ajuda
#
# Variaveis de ambiente:
#   RUNNER_TOKEN_FILE   arquivo com o Bearer do runner (obrigatorio; o token NUNCA vem por argumento)
#   RUNNER_PORT         porta do runner em 127.0.0.1 (padrao 4300; tem de ser numero)
#   CARD_MAX_TEMPO      so para testes: prazo de cada chamada, em segundos (inteiro de 1 a 3600; fora disso vale 60)
#   DGCLAW_CARD_INTERVALO  so para testes: segundos entre olhadas do "esperar" (padrao 5)
#
# O endereco do runner e FIXO: http://127.0.0.1:$RUNNER_PORT. Nenhuma URL vinda de argumento,
# de variavel ou de arquivo e usada: um e-mail ou pagina nao consegue apontar este comando para fora.
#
# Seguranca do token: ele so existe dentro do script. Vai para o curl pelo stdin (-K -), montado
# com o printf (builtin do bash, nao vira processo), entao nao aparece em argv, nem no "ps",
# nem em saida, nem em log.
#
# Codigos de saida:
#   0  ok
#   1  erro de uso ou de dado (argumento faltando, id invalido, arquivo ilegivel)
#   2  o runner nao respondeu (fora do ar, reiniciando)
#   3  o token nao esta disponivel ou o runner o recusou (401)
#   4  limite de cards abertos atingido (429)
#   5  o provedor deste agente ainda nao esta conectado (sem login ou sem chave)
#   6  outro erro devolvido pelo runner (a mensagem dele e mostrada)
#   7  "esperar" estourou o tempo sem o card terminar o turno (nao diz se ele trabalha ou esta parado)
#      Se o "abrir" criar o card e falhar ao entregar o pedido, a saida e a do erro (2, 3, 4 ou 6) e a
#      mensagem diz o id do card que ficou aberto; sem login, o card recem criado e fechado sozinho.
#      So se diz "nao foi entregue" quando o runner recusou o pedido (resposta 4xx). Se a resposta se perdeu
#      ou veio 5xx, a mensagem diz "entrega incerta": o card pode ja estar trabalhando. Confira com
#      "dgclaw-card estado <id>", avise o dono e NUNCA repita o pedido.
#      Se o card abriu mas o "dgclaw-monitor add" falhou, a saida e 8: o card esta aberto e SEM monitor,
#      e a mensagem traz o comando para ligar o monitor a mao.
#   8  (so no "abrir --monitor") o card abriu e o pedido foi entregue, mas o monitor nao ligou
#   9  (so no "abrir") o card foi criado, mas o runner nao OBSERVOU o primeiro turno do pedido dentro da espera
#      (--espera-turno). Isso nao prova que o card esteja parado: o pedido ainda pode comecar (ou ja estar rodando sem
#      ser observado). Nao feche e nao reenvie por conta propria (pode duplicar); confira com "estado" e "ler" depois
#      de um tempo. Nao diga ao dono que o card esta trabalhando, nem que esta parado, antes de ver o primeiro turno.
#  10  (so no "fechar") o runner ainda nao observou turno (turnosAceitosSessao igual a 0), ainda tem texto na fila ou sendo digitado, o runner ainda espera o recibo do Enter de um texto (reciboPendente) ou nao deu para ler o estado dele.
#      Fechar pode jogar fora o pedido. Repita com --forcar se for isso mesmo.
#  11  (so no "abrir") o card foi criado e o pedido entregue, mas nao consegui confirmar se ele aceitou o pedido
#      (consulta recusada, erro do runner, de rede, resposta sem JSON ou sem o contador turnosAceitos). Nao e 9 nem 0:
#      veja "dgclaw-card estado <id>" antes de dizer qualquer coisa ao dono.
#      Com --monitor, o monitor e ligado logo depois de entregar o pedido, antes da espera pelo turno; assim os
#      codigos 9, 11 e 12 tambem ficam com monitor. Falha ao ligar o monitor sai com 8.
#  12  (so no "abrir") o card aceitou o pedido (houve turno), mas o turno falhou e o card esta em erro. Veja o que
#      ele fez com "dgclaw-card ler <id>" e conte ao dono. Nao e 0: nao anuncie que o trabalho esta indo bem.
set -euo pipefail
umask 077

erro() { echo "dgclaw-card: $*" >&2; }
die() { local c="${CODIGO:-1}"; erro "$*"; exit "$c"; }

command -v curl >/dev/null || die "o curl nao foi encontrado no container. Avise quem mantem a imagem do agente."
command -v jq >/dev/null || die "o jq nao foi encontrado no container. Avise quem mantem a imagem do agente."

PORTA="${RUNNER_PORT:-4300}"
[[ "$PORTA" =~ ^[0-9]+$ ]] && [ "$PORTA" -ge 1 ] && [ "$PORTA" -le 65535 ] \
  || die "RUNNER_PORT precisa ser um numero de 1 a 65535 (recebido: '$PORTA'). Corrija a variavel ou deixe-a vazia para usar a porta 4300."
BASE="http://127.0.0.1:$PORTA"

# --- token ----------------------------------------------------------------
TOKEN=""
carregar_token() {
  local arq="${RUNNER_TOKEN_FILE:-}"
  [ -n "$arq" ] || CODIGO=3 die "RUNNER_TOKEN_FILE nao esta definida, entao nao tenho como me identificar ao runner. Peca ao dono para reiniciar o agente pelo painel (o instalador define essa variavel)."
  [ -r "$arq" ] || CODIGO=3 die "nao consegui ler o arquivo de token apontado por RUNNER_TOKEN_FILE ($arq). Peca ao dono para reiniciar o agente pelo painel; se continuar, o instalador precisa ser rodado de novo."
  TOKEN="$(tr -d '\r\n' < "$arq")"
  [ -n "$TOKEN" ] || CODIGO=3 die "o arquivo de token ($arq) esta vazio. Peca ao dono para reiniciar o agente pelo painel; se continuar, o instalador precisa ser rodado de novo."
  # O token entra numa linha de configuracao do curl: so caracteres seguros, nada que feche a aspa.
  [[ "$TOKEN" =~ ^[A-Za-z0-9._~+/=-]+$ ]] || CODIGO=3 die "o arquivo de token ($arq) tem caracteres que um token do runner nao tem. Peca ao dono para reiniciar o agente pelo painel."
}

# --- chamada ao runner ----------------------------------------------------
# chamar METODO CAMINHO [CORPO_JSON]  ->  preenche HTTP (codigo) e RESP (corpo). Retorna 2 se o runner nao respondeu.
HTTP=""; RESP=""
# Prazo de cada chamada: inteiro decimal de 1 a 3600. Qualquer outra coisa (inclusive texto com quebra de linha)
# vira 60, com um aviso no stderr. Roda em subshell, entao o aviso so sai uma vez por chamada.
prazo_da_chamada() {
  local p="${CARD_MAX_TEMPO:-60}"
  if [[ "$p" =~ ^[0-9]{1,4}$ ]] && [ $((10#$p)) -ge 1 ] && [ $((10#$p)) -le 3600 ]; then
    printf '%s' "$((10#$p))"
  else
    erro "aviso: CARD_MAX_TEMPO precisa ser um numero inteiro de segundos, de 1 a 3600; usei 60."
    printf '60'
  fi
}
chamar() {
  local metodo="$1" caminho="$2" corpo="${3:-}" cfg saida prazo
  prazo="$(prazo_da_chamada)"
  cfg="$(printf 'url = "%s%s"\nrequest = "%s"\nheader = "Authorization: Bearer %s"\nwrite-out = "\\n%%{http_code}"\n' "$BASE" "$caminho" "$metodo" "$TOKEN")"
  if [ -n "$corpo" ]; then
    corpo="${corpo//\\/\\\\}"; corpo="${corpo//\"/\\\"}"
    cfg+="$(printf '\nheader = "Content-Type: application/json"\ndata = "%s"' "$corpo")"
  fi
  # stderr do curl suprimido: a mensagem pode citar o Bearer. A falha vira HTTP=000 e falha_geral explica o que fazer.
  # O prazo vai como argumento do curl, ja validado: nunca entra no arquivo de configuracao que leva o Bearer.
  if ! saida="$(printf '%s\n' "$cfg" | curl -sS --max-time "$prazo" -K - 2>/dev/null)"; then
    HTTP="000"; RESP=""
    return 2
  fi
  HTTP="${saida##*$'\n'}"
  RESP="${saida%$'\n'*}"
  return 0
}

# Como chamar, mas ja trata as falhas gerais (runner fora, 401, 429, outros) e sai. Em sucesso (2xx) volta.
# $1 = metodo, $2 = caminho, $3 = corpo, e a variavel QUEM (nome do provedor) ajuda na frase de "sem login".
chamar_ou_sair() {
  chamar "$@" || falha_geral
  case "$HTTP" in
    2??) return 0 ;;
    *) falha_geral ;;
  esac
}

# Campo ausente ou resposta sem JSON viram texto vazio; cada chamador ja trata o vazio (erro, valor padrao ou nova tentativa).
campo() { printf '%s' "$RESP" | jq -r "$1 // empty" 2>/dev/null || true; }

# Como "campo", mas devolve "false" quando o valor e false (o "// empty" do jq descartaria o false). Ausente ou outro tipo: vazio.
campo_booleano() { printf '%s' "$RESP" | jq -r "if ($1 | type) == \"boolean\" then $1 | tostring else empty end" 2>/dev/null || true; }

nome_do_provedor() { # $1 = codex|claude|vazio
  case "$1" in codex) echo "Codex" ;; claude) echo "Claude" ;; *) echo "provedor" ;; esac
}

# Fala do jeito que o agente pode repassar ao dono, e sai com o codigo certo.
falha_geral() {
  local code err fix prov
  if [ "$HTTP" = "000" ]; then
    CODIGO=2 die "o runner deste agente nao respondeu em 127.0.0.1:$PORTA. Ele pode estar reiniciando: espere cerca de um minuto e tente de novo. Se continuar assim, peca ao dono para tocar em Reiniciar no painel."
  fi
  code="$(campo .code)"; err="$(campo .error)"; fix="$(campo .howToFix)"
  case "$HTTP:$code" in
    401:*|403:*)
      CODIGO=3 die "o runner recusou o acesso (token invalido). Isso e um problema de instalacao, nao do pedido. Peca ao dono para reiniciar o agente pelo painel; se continuar, o instalador precisa ser rodado de novo." ;;
    429:*|*:LIMITE_DE_SESSOES)
      CODIGO=4 die "${err:-Ja ha cards demais abertos.} Para liberar uma vaga, feche um card que nao precisa mais: veja com 'dgclaw-card listar' e feche com 'dgclaw-card fechar <id>'. Se o dono quiser mais vagas, o limite sobe em RUNNER_MAX_SESSOES_EXTRAS na unidade do runner." ;;
    *:SEM_LOGIN|*:SEM_CHAVE)
      prov="$(nome_do_provedor "${QUEM:-}")"
      CODIGO=5 die "o $prov deste agente ainda nao esta conectado. Peca ao dono para abrir o painel, aba Status, cartao Modelo e autenticacao, e usar Entrar com a assinatura (ou colar a chave de API). Depois que ele conectar, e so repetir o pedido." ;;
  esac
  local msg="${err:-o runner respondeu HTTP $HTTP sem explicar}"
  [ -z "$fix" ] || msg="$msg. O que fazer: $fix"
  [ -z "$code" ] || msg="$msg [$code]"
  if [ -z "$err" ]; then
    local cru; cru="$(printf '%s' "$RESP" | head -c 200 | tr '\n' ' ')"
    [ -z "$cru" ] || msg="$msg (resposta: $cru)"
  fi
  CODIGO=6 die "$msg"
}

validar_id() {
  [ -n "${1:-}" ] || die "falta o id do card. Veja os ids com 'dgclaw-card listar'."
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "id de card invalido: '$1'. Ele so tem letras, numeros, ponto, hifen e sublinhado; veja os ids com 'dgclaw-card listar'."
}

# Le o texto do pedido: argumento, arquivo ou stdin. Resultado em TEXTO.
TEXTO=""
ler_texto() { # $1 = texto|"" ; $2 = arquivo|"" ; $3 = rotulo para a mensagem
  if [ -n "$1" ]; then TEXTO="$1"
  elif [ -n "$2" ]; then
    [ -r "$2" ] || die "nao consegui ler o arquivo '$2'. Confira o caminho e a permissao."
    TEXTO="$(cat -- "$2")"
  elif [ ! -t 0 ]; then
    TEXTO="$(cat)"
  else
    die "faltou o texto do $3. Passe-o como argumento, com --arquivo/--pedido-arquivo, ou por pipe (echo ... | dgclaw-card ...)."
  fi
  [ -n "${TEXTO//[[:space:]]/}" ] || die "o texto do $3 esta vazio. Escreva o que a outra sessao deve fazer."
}

enviar_texto() { # $1 id ; texto em TEXTO
  local corpo
  corpo="$(printf '%s' "$TEXTO" | jq -Rsc '{text: ., submit: true}')"
  chamar_ou_sair POST "/api/agents/$1/input" "$corpo"
}

# --- subcomandos ----------------------------------------------------------
cmd_abrir() {
  local provedor="" auth="" modelo="" titulo="" pedido="" arquivo="" monitor=0 entregue="" cada="" espera=60
  while [ $# -gt 0 ]; do
    case "$1" in
      --provedor) provedor="${2:-}"; shift 2 || die "falta o valor de --provedor." ;;
      --auth) auth="${2:-}"; shift 2 || die "falta o valor de --auth." ;;
      --modelo) modelo="${2:-}"; shift 2 || die "falta o valor de --modelo." ;;
      --titulo) titulo="${2:-}"; shift 2 || die "falta o valor de --titulo." ;;
      --pedido) pedido="${2:-}"; shift 2 || die "falta o valor de --pedido." ;;
      --pedido-arquivo) arquivo="${2:-}"; shift 2 || die "falta o valor de --pedido-arquivo." ;;
      --monitor) monitor=1; shift ;;
      --entregue) entregue="${2:-}"; shift 2 || die "falta o valor de --entregue." ;;
      --cada) cada="${2:-}"; shift 2 || die "falta o valor de --cada." ;;
      --espera-turno) espera="${2:-}"; shift 2 || die "falta o valor de --espera-turno." ;;
      *) die "opcao desconhecida em 'abrir': '$1'. Veja 'dgclaw-card ajuda'." ;;
    esac
  done
  case "$provedor" in codex|claude) ;; *) die "--provedor precisa ser codex ou claude (recebido: '${provedor}')." ;; esac
  case "$auth" in ""|assinatura|api|token) ;; *) die "--auth precisa ser assinatura, api ou token (recebido: '$auth')." ;; esac
  if ! [[ "$espera" =~ ^[0-9]{1,4}$ ]] || [ $((10#$espera)) -gt 3600 ]; then
    die "--espera-turno precisa ser um numero inteiro de segundos, de 0 a 3600 (0 desliga; recebido: '$espera'). Nenhum card foi aberto."
  fi
  espera=$((10#$espera))
  # Confere o monitor ANTES de criar o card: erro de uso nao pode deixar card aberto para tras.
  if [ "$monitor" = 1 ]; then
    [ -n "${entregue//[[:space:]]/}" ] || die "--monitor precisa de --entregue \"criterio de entregue\": diga como saber que o card terminou (ex.: --entregue \"o relatorio salvo em /home/agente/relatorio.md\"). Nenhum card foi aberto."
    [ -z "$cada" ] || { [[ "$cada" =~ ^[0-9]+$ ]] && [ "$cada" -ge 1 ]; } || die "--cada precisa ser um numero inteiro de minutos, maior que zero (recebido: '$cada'). Nenhum card foi aberto."
  else
    [ -z "$entregue$cada" ] || die "--entregue e --cada so valem junto com --monitor. Acrescente --monitor, ou tire essas opcoes."
  fi
  [ -n "$titulo" ] || die "falta --titulo: um nome curto para o card aparecer no painel (ex.: --titulo \"Revisao do contrato\")."
  ler_texto "$pedido" "$arquivo" "pedido"
  QUEM="$provedor"

  local corpo id
  corpo="$(jq -nc --arg p "$provedor" --arg a "$auth" --arg m "$modelo" --arg t "$titulo" \
    '{tipo: "card", provedor: $p, titulo: $t} + (if $a != "" then {auth: $a} else {} end) + (if $m != "" then {modelo: $m} else {} end)')"
  chamar_ou_sair POST /api/sessoes "$corpo"
  id="$(campo .data.id)"
  [ -n "$id" ] || CODIGO=6 die "o runner criou o card mas nao devolveu o id (resposta inesperada). Veja 'dgclaw-card listar'."
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || CODIGO=6 die "o runner devolveu um id de card com caracteres invalidos. Veja 'dgclaw-card listar'."
  # O id sai uma vez no stdout assim que o card existe, antes do /input: se este processo for interrompido na
  # entrega, quem chamou ja tem o id para consultar o card.
  echo "$id"

  # O /input pode falhar depois do card existir. Sem login, o card nao serve para nada: fecha para nao ocupar vaga.
  # Se a chamada falhar, HTTP fica 000 e o case abaixo cai no ramo de erro, que avisa e sai.
  chamar POST "/api/agents/$id/input" "$(printf '%s' "$TEXTO" | jq -Rsc '{text: ., submit: true}')" || true
  case "$HTTP" in
    2??) ;;
    *)
      # Guarda a resposta do /input: o DELETE logo abaixo sobrescreve HTTP e RESP.
      local http_input="$HTTP" resp_input="$RESP" code
      code="$(campo .code)"
      if [ "$code" = "SEM_LOGIN" ] || [ "$code" = "SEM_CHAVE" ]; then
        if ! chamar DELETE "/api/sessoes/$id"; then
          erro "aviso: o card $id ficou aberto porque o runner nao respondeu ao pedido de fechamento. Feche com: dgclaw-card fechar $id --forcar."
        else
          case "$HTTP" in
            2??) erro "aviso: o card $id foi fechado porque o agente esta sem login; o id acima nao vale mais." ;;
            *) erro "aviso: nao confirmei a remocao do card $id (o runner respondeu HTTP $HTTP ao pedido de fechamento). O card pode ter ficado aberto. Confira com 'dgclaw-card listar' e feche com: dgclaw-card fechar $id --forcar." ;;
          esac
        fi
        HTTP="$http_input"; RESP="$resp_input"
        falha_geral
      fi
      case "$http_input:$code" in
        503:SEM_CAPACIDADE|500:NAO_ACORDOU)
          # Recusa do runner por falta de capacidade ou por nao conseguir acordar a sessao: veio antes da fila.
          erro "o card $id foi criado, mas o pedido nao foi entregue ($(campo .error)); pode tentar de novo quando houver capacidade, com: dgclaw-card mandar $id --arquivo <arquivo do pedido>, ou feche com: dgclaw-card fechar $id --forcar.$(dica_monitor "$id" "$entregue" "$cada")"
          HTTP="$http_input"; RESP="$resp_input"
          falha_geral ;;
      esac
      case "$http_input" in
        4??)
          # Recusa do runner (4xx): so aqui se prova que o texto nao entrou na fila.
          erro "o card $id foi criado, mas o pedido nao foi entregue (o runner o recusou antes de enfileirar). Reenvie com: dgclaw-card mandar $id --arquivo <arquivo do pedido>, ou feche com: dgclaw-card fechar $id --forcar.$(dica_monitor "$id" "$entregue" "$cada")"
          HTTP="$http_input"; RESP="$resp_input"
          falha_geral ;;
        *)
          # Resposta perdida (rede, tempo esgotado) ou 5xx: o texto pode ter entrado na fila. Nunca repetir.
          local causa
          if [ "$http_input" = "000" ]; then causa="o runner nao respondeu ao envio do pedido"
          else HTTP="$http_input"; RESP="$resp_input"; causa="o runner respondeu HTTP $http_input ao envio do pedido: $(campo .error)"; fi
          # Com --monitor, o vigia entra mesmo assim (o id ja e conhecido), para o card nao ficar sem acompanhamento.
          local aviso_mon=""
          if [ "$monitor" != 0 ]; then
            if aviso_mon="$( { ligar_monitor "$id" "$entregue" "$cada" && printf '%s' "$MON_OUT"; } 2>&1 )"; then
              aviso_mon=" Monitor ligado: $aviso_mon"
            else
              aviso_mon=" O monitor NAO ligou, o card esta sem vigia: $aviso_mon"
            fi
          fi
          CODIGO=$([ "$http_input" = "000" ] && echo 2 || echo 6) die "entrega incerta: o card $id foi criado e nao sei se o pedido entrou ($causa). O card pode ja estar trabalhando. Confira com 'dgclaw-card estado $id' e 'dgclaw-card ler $id', conte ao dono o que viu e NAO reenvie o pedido nem faca a tarefa pela conversa principal.$aviso_mon" ;;
      esac ;;
  esac
  # O /input responde 202 assim que o texto entra na fila, antes de o CLI aceitar o pedido como turno.
  # So dizemos "card aberto" depois de ver o primeiro turno; senao o agente avisa o dono de um trabalho que nao existe.
  # O monitor entra ANTES da espera: se o pedido nao virar turno (9) ou a consulta falhar (11), o card ja tem vigia.
  MON_OUT=""
  [ "$monitor" = 0 ] || ligar_monitor "$id" "$entregue" "$cada"
  if [ "$espera" = 0 ]; then
    echo "Card criado em $(nome_do_provedor "$provedor") e pedido entregue a fila. Com --espera-turno 0 o aceite do pedido NAO foi verificado: nao diga ao dono que o card esta trabalhando antes de conferir com 'dgclaw-card estado $id'."
  else
    ESPERANDO_DECISAO=0
    esperar_primeiro_turno "$id" "$espera"
    if [ "$ESPERANDO_DECISAO" = 1 ]; then
      echo "Card aberto em $(nome_do_provedor "$provedor"): ele aceitou o pedido e esta esperando uma decisao do dono (uma pergunta ou uma permissao). O dono responde na aba Sessoes do painel. Para ver o que ele pediu: dgclaw-card ler $id"
    else
      echo "Card aberto em $(nome_do_provedor "$provedor"). Para acompanhar: dgclaw-card esperar $id && dgclaw-card ler $id"
    fi
  fi
  [ -z "$MON_OUT" ] || echo "$MON_OUT"
}

# Comando para religar o monitor a mao (card criado, pedido a reenviar). O criterio vai escapado com printf %q.
dica_monitor() { # $1 id ; $2 entregue ; $3 cada
  [ "$monitor" != 0 ] || return 0
  local q; q="$(printf '%q' "$2")"
  printf ' Como o abrir foi pedido com --monitor, depois de reenviar ligue o monitor com o mesmo criterio e intervalo: dgclaw-monitor add %s --entregue %s%s (o criterio vai escapado para o shell; confira se ele ficou igual ao que voce pediu).' "$1" "$q" "${3:+ --cada $3}"
}

# Espera o pedido virar turno: turnosAceitosSessao > 0 (turnos da conversa ATUAL) ou status working. Sem turno no
# prazo (e com a consulta funcionando), sai com 9. Se nao deu para OBSERVAR o estado (HTTP 401/403/5xx, rede,
# consulta que estourou o tempo, JSON invalido, sem o contador), sai com 11: nunca 9 nem 0, porque nao se sabe se
# o card aceitou o pedido. Card em erro: 12 (o pedido foi aceito, mas o turno falhou).
# Cada consulta e cada pausa ficam limitadas ao tempo que resta do prazo (minimo 1 s para a consulta).
esperar_primeiro_turno() { # $1 id ; $2 segundos
  local inicio=$SECONDS passo="${DGCLAW_CARD_INTERVALO:-5}" turnos status falha="" resta erro_turno razao fila="" fila_presa=0 ultimo_status="" recibo="" recibo_preso=0 erro_visto=""
  [ "$passo" = 5 ] && passo=1
  while :; do
    falha=""; fila_presa=0; recibo_preso=0; erro_visto=""
    resta=$(( $2 - (SECONDS - inicio) )); [ "$resta" -ge 1 ] || resta=1
    if ! CARD_MAX_TEMPO="$resta" chamar GET "/api/agents/$1"; then
      falha="o runner nao respondeu a consulta do estado (erro de rede ou tempo esgotado)"
    elif [ "$HTTP" != 200 ]; then
      falha="o runner respondeu HTTP $HTTP: $(campo .error)"
    elif ! printf '%s' "$RESP" | jq -e '.data | type == "object"' >/dev/null 2>&1; then
      falha="a resposta do runner nao e um JSON com o estado do card"
    else
      turnos="$(campo .data.turnosAceitosSessao)"; status="$(campo .data.status)"; ultimo_status="$status"
      if ! [[ "$turnos" =~ ^[0-9]+$ ]]; then
        # Esse campo nao aparece com o tempo: nao adianta esperar o prazo todo.
        sem_confirmacao "$1" "a resposta do runner nao traz o contador turnosAceitosSessao (runner antigo ou resposta incompleta)"
      fi
      # Textos pendentes: os da fila mais o que esta sendo digitado agora (naFilaTotal). sessao.fila nao conta o item em voo.
      fila="$(campo .data.naFilaTotal)"
      if ! [[ "$fila" =~ ^[0-9]+$ ]]; then
        sem_confirmacao "$1" "a resposta do runner nao traz o campo naFilaTotal (textos pendentes do card), entao nao da para ver se o pedido ja saiu da fila"
      fi
      # Recibo pendente: o texto ja saiu da fila, mas o runner ainda espera o recibo do Enter (o pedido pode estar so na caixa de texto).
      recibo="$(campo_booleano .data.reciboPendente)"
      if [ "$recibo" != true ] && [ "$recibo" != false ]; then
        sem_confirmacao "$1" "a resposta do runner nao traz o campo reciboPendente (recibo do Enter de um texto digitado), entao nao da para ver se o pedido foi aceito pelo CLI"
      fi
      # Falha de turno conhecida: estado errored, campo de erro preenchido (inclusive em card dormindo/resumable)
      # ou statusReason de falha. Do statusReason vale so o nome do evento (antes do primeiro espaco): o resto pode ser
      # o nome de uma ferramenta (ex.: "hook:PreToolUse mcp__logs__error_report"), que nao e falha. Nenhuma delas conta como sucesso, mesmo que haja turno ou o status seja working.
      erro_turno="$(campo .data.error)"; razao="$(campo .data.statusReason)"
      if [ "$status" = errored ] || [ -n "$erro_turno" ] || printf '%s' "${razao%% *}" | grep -qiE 'falh|erro|error|sem-login|sem-chave|login-expirado|identidade-grande|StopFailure'; then
        erro_turno="${erro_turno:-${razao:-sem detalhe}}"
        # Com o pedido ainda pendente (fila, item em voo ou recibo do Enter), o erro pode ser de OUTRA mensagem
        # (ex.: uma enviada pelo painel): nao sai com 12, segue esperando e deixa o prazo decidir.
        if [ "$turnos" != 0 ] && { [ "$fila" != 0 ] || [ "$recibo" = true ]; }; then
          erro_visto="$erro_turno"
        elif [ "$turnos" != 0 ]; then
          avisar_monitor
          CODIGO=12 die "o card $1 aceitou o pedido, mas o turno falhou e o card esta com erro: $erro_turno. Veja o que ele chegou a fazer com 'dgclaw-card ler $1' e conte ao dono o que aconteceu. Nao diga ao dono que o trabalho esta indo bem."
        else
          avisar_monitor
          CODIGO=6 die "o card $1 foi criado, mas esta com erro antes de o pedido virar turno: $erro_turno. Veja 'dgclaw-card estado $1'. Nao diga ao dono que ele esta trabalhando."
        fi
      fi
      # So o contador confirma o turno: working sozinho pode ser outra coisa (ex.: compactacao, hook:PreCompact).
      # Um turno so confirma o pedido se o texto dele ja saiu da fila: o painel pode digitar uma mensagem direto no
      # terminal (sem passar pela fila), e esse turno nao e o do pedido.
      if [ "$turnos" != 0 ]; then
        if [ "$fila" != 0 ]; then fila_presa=1
        elif [ "$recibo" = true ]; then recibo_preso=1
        else
          case "$status" in
            stopped|resumable)
              sem_confirmacao "$1" "o runner viu o turno do pedido, mas o terminal do card ja esta fechado (status $status); confira com 'dgclaw-card ler $1' antes de dizer qualquer coisa ao dono" ;;
          esac
          [ "$status" != waiting_input ] || ESPERANDO_DECISAO=1
          return 0
        fi
      fi
    fi
    if [ $((SECONDS - inicio)) -ge "$2" ]; then
      [ -z "$falha" ] || sem_confirmacao "$1" "$falha"
      if [ -n "$erro_visto" ]; then
        sem_confirmacao "$1" "vi um erro de turno ($erro_visto), mas ele pode ser de outra mensagem, porque o pedido ainda esta pendente (na fila, sendo digitado ou esperando o recibo do Enter)"
      fi
      [ "$fila_presa" = 0 ] || sem_confirmacao "$1" "o card teve um turno, mas ainda ha texto pendente (na fila ou sendo digitado); o pedido pode nao ter sido digitado ainda"
      [ "$recibo_preso" = 0 ] || sem_confirmacao "$1" "o card teve um turno, mas o runner ainda espera o recibo do Enter de um texto digitado (o pedido pode estar na caixa de texto)"
      # Resumable (tem conversa guardada, mas sem processo vivo): o contador da conversa pode ter zerado: dizer que o pedido nao virou turno seria um palpite.
      case "$ultimo_status" in
        resumable)
          sem_confirmacao "$1" "o card esta sem processo vivo (status $ultimo_status), entao o contador desta conversa pode ter zerado; confira a conversa" ;;
      esac
      # Claude sem nenhum hook recebido: o contador de turnos nao enxerga o aceite, entao 9 seria um palpite.
      if [ "${provedor:-}" = claude ] && [ "$(campo .data.hookActive)" != true ]; then
        sem_confirmacao "$1" "o runner ainda nao recebeu nenhum hook do Claude neste card, entao o contador de turnos nao consegue ver se o pedido foi aceito"
      fi
      avisar_monitor
      CODIGO=9 die "o card $1 foi criado, mas o runner nao observou o primeiro turno do pedido em $2 segundos. Isso nao prova que o card esteja parado: o pedido ainda pode comecar, ou ja estar rodando sem ter sido observado. Nao feche o card e nao reenvie por conta propria (isso pode duplicar o pedido). Confira com 'dgclaw-card estado $1' e 'dgclaw-card ler $1' depois de um tempo. Ate ver o primeiro turno, nao diga ao dono que o card esta trabalhando, e tambem nao diga que ele esta parado."
    fi
    resta=$(( $2 - (SECONDS - inicio) ))
    if [ "$resta" -lt 1 ] || [ "$(awk -v a="$passo" -v b="$resta" 'BEGIN{print (a>b)}')" = 1 ]; then passo="$resta"; fi
    [ "$passo" != 0 ] && sleep "$passo"
    passo="${DGCLAW_CARD_INTERVALO:-5}"; [ "$passo" = 5 ] && passo=1
  done
}

avisar_monitor() { [ -z "${MON_OUT:-}" ] || erro "$MON_OUT"; }

sem_confirmacao() { # $1 id ; $2 motivo
  avisar_monitor
  CODIGO=11 die "nao consegui confirmar se o card $1 aceitou o pedido: $2. O card foi criado e o pedido foi entregue, mas nao sei se ele esta trabalhando. Veja com 'dgclaw-card estado $1' e 'dgclaw-card ler $1'. Nao diga ao dono que ele esta trabalhando antes de ver isso, e nao reenvie nem feche por conta propria."
}

# Liga o modo monitor num card que acabou de abrir (guarda a frase do monitor em MON_OUT). O dgclaw-monitor
# mora ao lado deste script. Se falhar, o card segue aberto (o pedido ja foi entregue): avisa claro e sai com 8.
ligar_monitor() { # $1 id ; $2 criterio ; $3 minutos|vazio
  local mon args out
  mon="$(dirname "$(readlink -f "$0")")/dgclaw-monitor"
  args=(add "$1" --entregue "$2")
  [ -z "$3" ] || args+=(--cada "$3")
  # O id ja saiu no stdout (primeira linha) quando o card foi criado.
  if [ ! -x "$mon" ]; then
    CODIGO=8 die "o card $1 esta aberto, mas SEM monitor: nao achei o dgclaw-monitor ($mon). Avise quem mantem a imagem do agente. Quando existir, ligue com: dgclaw-monitor add $1 --entregue \"...\""
  fi
  if ! out="$("$mon" "${args[@]}" 2>&1)"; then
    CODIGO=8 die "o card $1 esta aberto e o pedido foi entregue, mas o monitor NAO ligou: ${out:-sem mensagem}. Para ligar a mao: dgclaw-monitor add $1 --entregue \"<criterio de entregue>\" [--cada MIN]"
  fi
  MON_OUT="$out"
}

cmd_mandar() {
  local id="${1:-}" texto="" arquivo=""
  validar_id "$id"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --arquivo) arquivo="${2:-}"; shift 2 || die "falta o valor de --arquivo." ;;
      *) [ -z "$texto" ] || die "texto demais em 'mandar': coloque o texto entre aspas, ou use --arquivo."; texto="$1"; shift ;;
    esac
  done
  ler_texto "$texto" "$arquivo" "texto a mandar"
  QUEM="$(provedor_do "$id")"
  enviar_texto "$id"
  echo "Texto enviado ao card $id. Para acompanhar: dgclaw-card esperar $id && dgclaw-card ler $id"
}

# Provedor de uma sessao (codex|claude|vazio), sem sair se falhar: so serve para a frase de erro.
provedor_do() {
  local p=""
  if chamar GET "/api/provedor?sessao=$1"; then
    case "$HTTP" in 2??) p="$(campo .provedor)" ;; esac
  fi
  printf '%s' "$p"
}

cmd_estado() {
  validar_id "${1:-}"
  local id="$1" status titulo fila reason prov auth modelo turnos hook
  chamar_ou_sair GET "/api/agents/$id"
  turnos="$(campo .data.turnosAceitosSessao)"
  status="$(campo .data.status)"; titulo="$(campo .data.sessao.titulo)"; fila="$(campo .data.sessao.fila)"
  reason="$(campo .data.error)"
  chamar_ou_sair GET "/api/provedor?sessao=$id"
  prov="$(campo .provedor)"; auth="$(campo .auth)"; modelo="$(campo .modelo)"
  echo "$id: ${status:-desconhecido}${fila:+ (na fila: $fila)}${titulo:+ | titulo: $titulo}"
  echo "provedor: ${prov:-?} | auth: ${auth:-?} | modelo: ${modelo:-padrao}"
  [ -z "$reason" ] || echo "aviso do runner: $reason"
  if [ "$turnos" = 0 ]; then
    echo "primeiro turno ainda nao observado pelo runner (isso nao prova que o card esteja parado); confira com 'dgclaw-card ler $id'"
  fi
}

cmd_esperar() {
  local id="${1:-}" max=900 visto=0 seguidas=0 status fila ultimo passo="${DGCLAW_CARD_INTERVALO:-5}"
  validar_id "$id"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --max) max="${2:-}"; shift 2 || die "falta o valor de --max." ;;
      *) die "opcao desconhecida em 'esperar': '$1'. Use --max SEGUNDOS." ;;
    esac
  done
  [[ "$max" =~ ^[0-9]+$ ]] || die "--max precisa ser um numero de segundos (recebido: '$max')."
  local inicio=$SECONDS
  while :; do
    chamar_ou_sair GET "/api/agents/$id"
    status="$(campo .data.status)"; fila="$(campo .data.sessao.fila)"; fila="${fila:-0}"
    case "$status" in
      working) visto=1; seguidas=0 ;;
      errored)
        CODIGO=6 die "o card $id parou com erro: $(campo .data.error). Veja 'dgclaw-card estado $id'; se for falta de login, peca ao dono para conectar o provedor no painel." ;;
      idle|completed|resumable|stopped)
        if [ "$fila" = "0" ]; then
          # Fim do turno: o Stop do Claude/Codex vira "idle" no runner. Voltar a idle depois de ter
          # visto "working" basta. Sem ter visto (o turno foi mais rapido que a olhada), vale a
          # ultima mensagem ser do assistente, confirmada em duas olhadas seguidas.
          if [ "$visto" = 1 ] && [ "$status" = idle ]; then echo "O card $id terminou o turno. Leia com: dgclaw-card ler $id"; return 0; fi
          chamar_ou_sair GET "/api/agents/$id/conversation?limit=2"
          # Sem a ultima mensagem (resposta sem JSON), segue esperando; o limite de --max encerra com erro.
          ultimo="$(printf '%s' "$RESP" | jq -r '.data | last | .role // empty' 2>/dev/null || true)"
          if [ "$ultimo" = "assistant" ]; then
            seguidas=$((seguidas+1))
            if [ "$seguidas" -ge 2 ]; then echo "O card $id terminou o turno. Leia com: dgclaw-card ler $id"; return 0; fi
          else seguidas=0; fi
        else seguidas=0; fi ;;
      *) seguidas=0 ;;
    esac
    if [ $((SECONDS - inicio)) -ge "$max" ]; then
      CODIGO=7 die "passaram $max segundos e o card $id nao terminou o turno nesse prazo. Espere mais com 'dgclaw-card esperar $id --max <segundos>', ou leia o que ja existe com 'dgclaw-card ler $id'."
    fi
    sleep "$passo"
  done
}

cmd_ler() {
  local id="${1:-}" n=4
  validar_id "$id"; shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --n) n="${2:-}"; shift 2 || die "falta o valor de --n." ;;
      *) die "opcao desconhecida em 'ler': '$1'. Use --n N." ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] || die "--n precisa ser um numero maior que zero (recebido: '$n')."
  chamar_ou_sair GET "/api/agents/$id/conversation?limit=$n"
  # Resposta sem JSON conta como conversa vazia; ler de novo mostra o conteudo quando o runner voltar ao normal.
  if [ "$(printf '%s' "$RESP" | jq '.data | length' 2>/dev/null || echo 0)" = "0" ]; then
    explicar_conversa_vazia "$id"
    return 0
  fi
  printf '%s' "$RESP" | jq -r '.data[] | (if .role == "assistant" then "[resposta]" else "[pedido]" end) + "\n" + .text + "\n"'
}

# Diz por que a conversa do card esta vazia, pelo estado dele, em vez de so "sem mensagens".
explicar_conversa_vazia() { # $1 id
  local id="$1" status fila turnos total
  if chamar GET "/api/agents/$id" && [[ "$HTTP" == 2* ]]; then
    status="$(campo .data.status)"; fila="$(campo .data.sessao.fila)"; fila="${fila:-0}"; turnos="$(campo .data.turnosAceitosSessao)"; total="$(campo .data.naFilaTotal)"; total="${total:-$fila}"
    if [ "$fila" != 0 ] && { [ "$status" = stopped ] || [ "$status" = resumable ]; }; then
      echo "O card $id ainda nao tem mensagens: ha um pedido guardado na fila ($fila), mas a sessao esta sem terminal aberto. Retomar no painel (aba Sessoes) processa o pedido, sem reenviar o texto."
    elif [ "$fila" != 0 ]; then
      echo "O card $id ainda nao tem mensagens: ha texto na fila ($fila) e o runner ainda nao observou o primeiro turno (isso nao prova que esteja parado). Confira 'dgclaw-card estado $id' e leia de novo com 'dgclaw-card ler $id' mais tarde, sem reenviar por conta propria."
    elif [ "$total" = 0 ] && { [ "$status" = stopped ] || { [ "$status" = resumable ] && [ "$turnos" = 0 ]; }; }; then
      echo "O card $id ainda nao tem mensagens: nao ha terminal aberto e nao ha texto pendente na fila, entao nada vai comecar sozinho. Confira com o agente ou com o resultado esperado antes de reenviar. Para continuar, use Retomar no painel (aba Sessoes) ou 'dgclaw-card mandar $id \"...\"'."
    elif [ "$status" = resumable ]; then
      echo "O card $id ainda nao tem mensagens: a sessao esta dormindo (sem terminal aberto). Ela acorda quando voce manda um recado: dgclaw-card mandar $id \"...\""
    elif [ "$turnos" = 0 ]; then
      echo "O card $id ainda nao tem mensagens: o runner ainda nao observou o primeiro turno (estado $status). Isso nao prova que o card esteja parado: o pedido pode ainda comecar. Confira 'dgclaw-card estado $id' e leia de novo com 'dgclaw-card ler $id' mais tarde, e nao reenvie por conta propria."
    elif [ "$status" = working ]; then
      echo "O card $id esta com o terminal ativo e a conversa ainda nao gravou nada. Espere com: dgclaw-card esperar $id"
    else
      echo "O card $id ainda nao tem mensagens para mostrar (estado $status). Se acabou de ser aberto, espere com: dgclaw-card esperar $id"
    fi
  else
    echo "O card $id ainda nao tem mensagens, e nao consegui ler o estado dele. Se acabou de ser aberto, espere com: dgclaw-card esperar $id"
  fi
}

cmd_listar() {
  local linhas id titulo status prov achou=0
  chamar_ou_sair GET "/api/agents?todas=1"
  linhas="$(printf '%s' "$RESP" | jq -r '.data[] | select(.sessao.tipo == "card") | [.id, (.sessao.titulo // "-"), (.status // "?")] | @tsv' 2>/dev/null)" \
    || erro "aviso: a resposta do runner para a lista de cards nao veio no formato esperado, entao a lista abaixo pode estar incompleta. Tente de novo com: dgclaw-card listar"
  while IFS=$'\t' read -r id titulo status; do
    [ -n "$id" ] || continue
    achou=1
    prov="$(provedor_do "$id")"
    printf '%s\t%s\t%s\t%s\n' "$id" "$titulo" "${prov:-?}" "$status"
  done <<< "$linhas"
  [ "$achou" = 1 ] || echo "Nenhum card aberto."
}

cmd_fechar() {
  validar_id "${1:-}"
  local id="$1" forcar=0 turnos fila
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --forcar) forcar=1; shift ;;
      *) die "opcao desconhecida em 'fechar': '$1'. Use --forcar." ;;
    esac
  done
  # Card que nunca teve turno (turnosAceitosSessao igual a 0) ainda tem o pedido guardado so na fila ou na caixa
  # de texto: fechar agora o joga fora. Se a leitura do estado falhar, nao da para saber: recusa tambem (10).
  if [ "$forcar" = 0 ]; then
    local motivo=""
    if ! chamar GET "/api/agents/$id"; then
      motivo="o runner nao respondeu a consulta do estado do card"
    elif [ "$HTTP" != 200 ]; then
      motivo="a consulta do estado do card voltou HTTP $HTTP"
    else
      turnos="$(campo .data.turnosAceitosSessao)"
      if ! [[ "$turnos" =~ ^[0-9]+$ ]]; then
        motivo="a resposta do runner nao traz o contador turnosAceitosSessao"
      elif [ "$turnos" = 0 ]; then
        motivo="o runner atual ainda nao observou um turno nesta conversa (pode haver respostas de antes de o runner reiniciar)"
      else
        fila="$(campo .data.naFilaTotal)"
        if ! [[ "$fila" =~ ^[0-9]+$ ]]; then
          motivo="a resposta do runner nao traz o campo naFilaTotal (textos pendentes do card)"
        elif [ "$fila" != 0 ]; then
          motivo="ainda ha $fila texto(s) pendente(s) no card (na fila ou sendo digitado), que seriam descartados"
        else
          recibo="$(campo_booleano .data.reciboPendente)"
          if [ "$recibo" = true ]; then
            motivo="o runner ainda espera o recibo de um texto digitado, que seria descartado"
          elif [ "$recibo" != false ]; then
            motivo="a resposta do runner nao traz o campo reciboPendente (recibo do Enter de um texto digitado)"
          fi
        fi
      fi
    fi
    if [ -n "$motivo" ]; then
      CODIGO=10 die "nao posso fechar o card $id: $motivo. Fechar agora pode jogar o pedido fora. Em vez de fechar, confira com 'dgclaw-card estado $id' e 'dgclaw-card ler $id' e conte ao dono o que aconteceu. Se for fechar mesmo assim, repita com: dgclaw-card fechar $id --forcar"
    fi
  fi
  chamar_ou_sair DELETE "/api/sessoes/$id"
  echo "Card $id fechado. A conversa dele continua guardada no disco."
}

cmd_ajuda() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

sub="${1:-ajuda}"
[ $# -eq 0 ] || shift
case "$sub" in
  ajuda|-h|--help) cmd_ajuda; exit 0 ;;
  abrir|mandar|estado|esperar|ler|listar|fechar) ;;
  *) die "subcomando desconhecido: '$sub'. Use abrir, mandar, estado, esperar, ler, listar, fechar ou ajuda." ;;
esac
carregar_token
"cmd_$sub" "$@"
